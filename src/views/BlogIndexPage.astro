---
// The blog archive, in either language (src/pages/blog/, src/pages/es/blog/).
// Posts not written in the page's language are listed in the one they were
// written in, with a language badge.
import { Icon } from 'astro-icon/components';
import MainLayout from '../layouts/MainLayout.astro';
import Navbar from '../components/Navbar.astro';
import CustomFooter from '../components/CustomFooter.astro';
import { BLOG_CATEGORIES, DEFAULT_IMAGE } from '../consts';
import { getPostList } from '../data/queries';
import { everyLocale, localePath, pick, useTranslations, type Locale } from '../i18n';
import { cardAward, categoryLabels, languageName, readingTime, shortDate } from '../utils/content';

interface Props {
	lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const alternates = everyLocale('/blog/');

const posts = await getPostList(lang);

const labels = categoryLabels(lang);

// Filter tabs: real links (/blog/?category=…) so they work without
// JavaScript; the script below filters in place instead of reloading.
const blog = localePath(lang, '/blog/');
const filters = [
	{ id: 'all', label: t('nav.all'), href: blog },
	...BLOG_CATEGORIES.map((c) => ({ id: c.id as string, label: labels[c.id], href: `${blog}?category=${c.id}` })),
];
---

<MainLayout title={t('blog.pageTitle')} description={t('blog.pageDescription')} lang={lang} alternates={alternates}>
	<Navbar variant="blog" lang={lang} alternates={alternates} />

	<main id="main-content" class="archive">
		<div class="container">
			<header class="archive-header">
				<h1 class="archive-title">{t('blog.heading')}</h1>
				<p class="archive-lead">{t('blog.lead')}</p>
			</header>

			<nav class="filter-tabs" aria-label={t('footer.blogCategories')} data-filter-param="category">
				{filters.map((f) => (
					<a class="filter-tab" href={f.href} data-filter={f.id}>{f.label}</a>
				))}
			</nav>

			<div class="blog-grid" id="blogGrid">
				{posts.map(({ entry: post, lang: postLang, href }) => (
					<article class="blog-card" data-filter-value={post.data.category ?? 'other'}>
						<div class="blog-card-inner">
							<div class="card-image">
								<img src={post.data.heroImage ?? DEFAULT_IMAGE} alt="" loading="lazy" />
							</div>
							<div class="card-content">
								<header class="blog-card-header">
									<div class="card-meta">
										<time datetime={post.data.pubDate.toISOString()} class="card-date">{shortDate(post.data.pubDate, lang)}</time>
										{post.data.category && (
											<span class={`category-badge category-${post.data.category}`}>
												{labels[post.data.category]}
											</span>
										)}
										{languageName(postLang, lang) && (
											<span class="post-badge" lang={postLang}>{languageName(postLang, lang)}</span>
										)}
										<span class="card-reading-time">{readingTime(post.body, lang)}</span>
									</div>
									{/* The stretched link makes the whole card clickable while only the title is announced. */}
									<h2 class="blog-card-title" lang={postLang}>
										<a href={href} hreflang={postLang} class="stretched-link">{post.data.title}</a>
									</h2>
									{post.data.award && (
										<p class="award-note mb-2">
											<Icon name="fa6-solid:trophy" aria-hidden="true" />
											<span>{cardAward(pick(post.data.award, lang))}</span>
										</p>
									)}
								</header>
								<p class="card-excerpt" lang={postLang}>{post.data.description}</p>
								<footer class="blog-card-footer">
									<span class="read-more" aria-hidden="true">{t('blog.readMore')}</span>
								</footer>
							</div>
						</div>
					</article>
				))}
			</div>

			<p class="text-center text-muted py-5" data-filter-empty hidden>{t('blog.empty')}</p>
		</div>
	</main>

	<CustomFooter lang={lang} />
</MainLayout>

<script>
  import { initArchiveFilter } from '../utils/archiveFilter';

  initArchiveFilter();
</script>

<style>
	.card-meta {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 0.4rem 0.6rem;
		margin-bottom: 0.7rem;
	}

	/* Category / language / award badges live in src/styles/global.css. */
	.card-reading-time {
		font-size: 0.8rem;
		color: var(--color-text-muted);
	}

	.blog-grid {
		display: grid;
		/* Fixed-width columns centred under the filters, so a short list
		   doesn't hug the left edge. */
		grid-template-columns: repeat(auto-fit, minmax(290px, 340px));
		justify-content: center;
		gap: 1.5rem;
	}

	.blog-card {
		border-radius: 10px;
		overflow: hidden;
		/* Containing block for the title's stretched link. */
		position: relative;
		transition: border-color 0.2s ease;
		background-color: var(--color-card);
		border: 1px solid var(--color-border);
		animation: fadeIn 0.5s ease forwards;
		opacity: 0;
	}

	.card-image {
		height: 170px;
		overflow: hidden;
	}

	.card-image img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.5s ease;
	}

	.blog-card:hover .card-image img { transform: scale(1.05); }

	.card-content {
		padding: 1.25rem 1.5rem 1.5rem;
		display: flex;
		flex-direction: column;
	}

	@keyframes fadeIn {
		from { opacity: 0; transform: translateY(20px); }
		to   { opacity: 1; transform: translateY(0); }
	}

	/* Same card language as the homepage: a border, no floating shadow. */
	.blog-card:hover {
		border-color: var(--color-border-strong);
	}

	.blog-card-inner {
		display: block;
		text-decoration: none;
		color: inherit;
	}

	.blog-card-header    { margin-bottom: 1rem; }

	.card-date {
		font-size: 0.85rem;
		color: var(--color-text-muted);
	}

	.blog-card-title {
		font-size: 1.2rem;
		font-weight: 600;
		line-height: 1.3;
		margin: 0 0 0.5rem;
		color: var(--color-heading);
		transition: color 0.2s ease;
	}

	.blog-card-title a { color: inherit; }

	.blog-card:hover .blog-card-title { color: var(--color-accent); }

	.card-excerpt {
		font-size: 1rem;
		line-height: 1.6;
		color: var(--color-text-secondary);
		margin-bottom: 1.5rem;
		flex-grow: 1;
	}

	.blog-card-footer  { margin-top: auto; }

	.read-more {
		display: inline-block;
		font-size: 0.9rem;
		font-weight: 500;
		color: var(--color-accent);
		transition: transform 0.2s ease;
	}

	.blog-card:hover .read-more { transform: translateX(5px); }

	.blog-card:nth-child(1) { animation-delay: 0.1s; }
	.blog-card:nth-child(2) { animation-delay: 0.2s; }
	.blog-card:nth-child(3) { animation-delay: 0.3s; }

	@media (max-width: 768px) {
		.blog-grid        { grid-template-columns: 1fr; gap: 1.5rem; }
		.card-content     { padding: 1.5rem; }
		.blog-card-title       { font-size: 1.3rem; }
	}
</style>
