---
// A blog post, in the language it's written in (src/pages/blog/[...slug].astro,
// src/pages/es/blog/[...slug].astro; see postPaths in ./paths.ts).
import { render } from 'astro:content';
import BlogPost from '../layouts/BlogPost.astro';
import type { Post } from '../data/queries';
import { pick, type Locale } from '../i18n';
import { readingTime } from '../utils/content';

interface Props {
	lang: Locale;
	post: Post;
	newer?: Post;
	older?: Post;
}

const { lang, post, newer, older } = Astro.props;
const { data } = post.entry;
const { Content } = await render(post.entry);
const link = (p?: Post) => p && { title: p.entry.data.title, href: p.href };
---

<BlogPost
	title={data.title}
	description={data.description}
	pubDate={data.pubDate}
	updatedDate={data.updatedDate}
	heroImage={data.heroImage}
	heroImageAlt={data.heroImageAlt}
	category={data.category}
	lang={lang}
	alternates={post.alternates}
	award={data.award && pick(data.award, lang)}
	readingTime={readingTime(post.entry.body, lang)}
	newer={link(newer)}
	older={link(older)}
>
	<Content />
</BlogPost>
