---
import { existsSync } from 'node:fs';
import { Icon } from 'astro-icon/components';
import { getCollection, render } from 'astro:content';
import LongformLayout, { type LongformFact } from '../../layouts/LongformLayout.astro';
import { getProject } from '../../data/queries';
import { AREA_META } from '../../data/areas';

export async function getStaticPaths() {
	// Newest first by catalog date; the previous/next links walk this order.
	const ordered = (
		await Promise.all((await getCollection('caseStudies')).map(async (entry) => ({ entry, project: await getProject(entry.id) })))
	)
		.sort((a, b) => (b.project?.date ?? '').localeCompare(a.project?.date ?? ''));
	return ordered.map(({ entry }, i) => ({
		params: { slug: entry.id },
		props: { entry, prev: ordered[i - 1]?.project, next: ordered[i + 1]?.project },
	}));
}

const { entry, prev, next } = Astro.props;
const project = await getProject(entry.id);
if (!project) {
	throw new Error(
		`Case study "${entry.id}" has no matching project in projects.json. ` +
			`Rename the file to a valid project slug or add the project.`,
	);
}
if (!project.date) {
	throw new Error(`Project "${project.slug}" has a case study, so it needs a "date" in projects.json.`);
}
const projectDate = project.date;
const area = AREA_META[project.category];
const { Content } = await render(entry);

// Dates are stored as UTC midnight; format in UTC so they don't shift a
// day (or a month) back in time zones west of UTC.
const dateLabel = new Date(projectDate).toLocaleDateString('en-us', {
	month: 'long',
	year: 'numeric',
	timeZone: 'UTC',
});

// Return to the homepage section that links to this case study. Engineering
// lists only repos with a status; everything else is in Selected work.
const fromWork = project.category !== 'software-engineering' || !project.status;
const back = fromWork
	? { href: '/#work', label: 'Back to Selected work' }
	: { href: '/#engineering', label: 'Back to Engineering' };

const facts: LongformFact[] = [
	...(entry.data.role ? [{ label: 'Role', value: entry.data.role }] : []),
	{ label: 'When', value: entry.data.timeframe ?? dateLabel },
	...(project.skills.length > 0 ? [{ label: 'Stack', value: project.skills.join(' · ') }] : []),
];

const pagerLink = (label: string, p?: typeof project) =>
	p && { label, title: p.title, href: `/projects/${p.slug}/` };

const gallery = entry.data.gallery ?? [];

// Thumbnails from `pnpm thumbs` live in a thumbs/ folder next to each photo.
// Fall back to the full-size file for any photo that doesn't have one yet.
const thumbOf = (src: string) => {
	const thumb = src.replace(/\/([^/]+)\.\w+$/, '/thumbs/$1.webp');
	return existsSync(`public${thumb}`) ? thumb : undefined;
};
---

<LongformLayout
	title={project.title}
	description={entry.data.outcome ?? project.description}
	lead={entry.data.outcome}
	image={entry.data.heroImage ?? project.image}
	imageAlt={entry.data.heroImageAlt}
	badges={[
		{ text: area.label, class: `post-badge ${area.gradientClass}` },
		// Titles no longer carry "Challenge:" / "Practice:"; the status says it.
		...(project.status ? [{ text: project.status, class: 'post-badge' }] : []),
	]}
	facts={facts}
	back={back}
	prev={pagerLink('Previous case study', prev)}
	next={pagerLink('Next case study', next)}
	publishedTime={new Date(projectDate).toISOString()}
	schemaType="Article"
>
	<Content />

	<Fragment slot="after">
		{gallery.length > 0 && (
			<section class="cs-gallery-section" aria-labelledby="gallery-title">
				<h2 id="gallery-title" class="cs-gallery-title">Photos</h2>
				<div class="cs-gallery" data-gallery>
					{gallery.map((img, i) => {
						const thumb = thumbOf(img.src);
						return (
						<figure class:list={['cs-gallery__item', { 'cs-gallery__item--wide': i === 0 }]}>
							<button type="button" class="cs-gallery__open" data-index={i}>
								<img
									src={thumb ?? img.src}
									srcset={thumb && `${thumb} 600w, ${img.src} 1600w`}
									sizes={i === 0 ? '(min-width: 992px) 860px, 100vw' : '(min-width: 992px) 280px, 50vw'}
									data-full={img.src}
									alt={img.alt || `${project.title} photo`}
									loading="lazy"
									decoding="async"
								/>
							</button>
							{img.caption && <figcaption>{img.caption}</figcaption>}
						</figure>
						);
					})}
				</div>

				<dialog class="cs-lightbox" aria-label="Photo viewer">
					<button type="button" class="cs-lightbox__btn cs-lightbox__close" aria-label="Close photo viewer">
						<Icon name="fa6-solid:xmark" aria-hidden="true" />
					</button>
					<button type="button" class="cs-lightbox__btn cs-lightbox__prev" aria-label="Previous photo">
						<Icon name="fa6-solid:chevron-left" aria-hidden="true" />
					</button>
					<figure class="cs-lightbox__figure">
						{/* src is set when a photo opens. */}
						<img class="cs-lightbox__img" alt="" />
						<figcaption class="cs-lightbox__caption" aria-live="polite">
							<span class="cs-lightbox__count"></span>
							<span class="cs-lightbox__text"></span>
						</figcaption>
					</figure>
					<button type="button" class="cs-lightbox__btn cs-lightbox__next" aria-label="Next photo">
						<Icon name="fa6-solid:chevron-right" aria-hidden="true" />
					</button>
				</dialog>
			</section>
		)}

		{project.links.length > 0 && (
			<div class="cs-links">
				{project.links.map((link) => (
					<a href={link.url} class="btn btn-outline-dark me-2 mb-2" target="_blank" rel="noopener noreferrer">
						<Icon name={link.icon} class="me-2" aria-hidden="true" />{link.text}
					</a>
				))}
			</div>
		)}
	</Fragment>
</LongformLayout>

<script>
	// Gallery viewer: thumbnails open a full-size <dialog>; arrows and the
	// keyboard step through the photos, Esc / backdrop / × close it.
	const gallery = document.querySelector<HTMLElement>('[data-gallery]');
	const dialog = document.querySelector<HTMLDialogElement>('.cs-lightbox');

	if (gallery && dialog) {
		const photos = [...gallery.querySelectorAll('figure')].map((fig) => {
			const img = fig.querySelector('img')!;
			return { src: img.dataset.full ?? img.src, alt: img.alt, caption: fig.querySelector('figcaption')?.textContent ?? '' };
		});
		const img = dialog.querySelector<HTMLImageElement>('.cs-lightbox__img')!;
		const count = dialog.querySelector<HTMLElement>('.cs-lightbox__count')!;
		const caption = dialog.querySelector<HTMLElement>('.cs-lightbox__text')!;
		let current = 0;

		const show = (i: number) => {
			current = (i + photos.length) % photos.length;
			img.src = photos[current].src;
			img.alt = photos[current].alt;
			count.textContent = `${current + 1} of ${photos.length}`;
			caption.textContent = photos[current].caption;
		};

		gallery.addEventListener('click', (e) => {
			const button = (e.target as HTMLElement).closest<HTMLElement>('[data-index]');
			if (!button) return;
			show(Number(button.dataset.index));
			dialog.showModal();
		});
		dialog.querySelector('.cs-lightbox__prev')!.addEventListener('click', () => show(current - 1));
		dialog.querySelector('.cs-lightbox__next')!.addEventListener('click', () => show(current + 1));
		dialog.querySelector('.cs-lightbox__close')!.addEventListener('click', () => dialog.close());
		// A click on the dialog itself (not its contents) is a backdrop click.
		dialog.addEventListener('click', (e) => {
			if (e.target === dialog) dialog.close();
		});
		dialog.addEventListener('keydown', (e) => {
			if (e.key === 'ArrowLeft') show(current - 1);
			if (e.key === 'ArrowRight') show(current + 1);
		});
	}
</script>

<style>
	/* Gallery: the first photo spans the row, the rest form a grid of
	   thumbnails that open in the viewer. The title matches .prose h2. */
	/* overflow: the global `section { overflow: hidden }` would clip the
	   thumbnails' focus outlines. */
	.cs-gallery-section { margin: 1rem 0 2.5rem; overflow: visible; }
	.cs-gallery-title {
		font-size: 1.6rem;
		font-weight: 600;
		letter-spacing: -0.01em;
		color: var(--color-heading);
		margin: 2.75rem 0 1.25rem;
	}
	.cs-gallery {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 1rem;
	}
	.cs-gallery__item { margin: 0; }
	.cs-gallery__item--wide { grid-column: 1 / -1; }
	.cs-gallery__open {
		display: block;
		width: 100%;
		padding: 0;
		border: none;
		background: none;
		border-radius: var(--radius-card, 1rem);
		overflow: hidden;
		cursor: zoom-in;
		box-shadow: var(--shadow-image);
	}
	.cs-gallery__open img {
		display: block;
		width: 100%;
		aspect-ratio: 3 / 2;
		object-fit: cover;
		transition: transform 0.3s ease;
	}
	.cs-gallery__open:hover img { transform: scale(1.03); }
	.cs-gallery__open:focus-visible {
		outline: 2px solid var(--color-accent, #4d9aff);
		outline-offset: 3px;
	}
	.cs-gallery figcaption {
		margin-top: 0.45rem;
		font-size: 0.85rem;
		color: var(--color-text-secondary);
	}
	@media (min-width: 992px) {
		.cs-gallery { grid-template-columns: repeat(3, 1fr); }
	}

	/* Viewer */
	.cs-lightbox {
		width: 100vw;
		height: 100vh;
		max-width: none;
		max-height: none;
		margin: 0;
		padding: 0;
		border: none;
		background: transparent;
	}
	.cs-lightbox[open] {
		display: flex;
		align-items: center;
		justify-content: center;
	}
	.cs-lightbox::backdrop { background: rgba(0, 0, 0, 0.88); }
	.cs-lightbox__figure {
		margin: 0;
		max-width: calc(100vw - 8rem);
		text-align: center;
	}
	.cs-lightbox__img {
		max-width: 100%;
		max-height: 82vh;
		object-fit: contain;
		border-radius: 0.5rem;
	}
	.cs-lightbox__caption {
		margin-top: 0.75rem;
		color: rgba(255, 255, 255, 0.85);
		font-size: 0.95rem;
	}
	.cs-lightbox__count {
		color: rgba(255, 255, 255, 0.6);
		font-variant-numeric: tabular-nums;
		margin-right: 0.75rem;
	}
	.cs-lightbox__btn {
		position: absolute;
		display: grid;
		place-items: center;
		width: 2.75rem;
		height: 2.75rem;
		border: none;
		border-radius: 50%;
		color: #fff;
		background: rgba(255, 255, 255, 0.12);
		font-size: 1.1rem;
		cursor: pointer;
	}
	.cs-lightbox__btn:hover { background: rgba(255, 255, 255, 0.25); }
	.cs-lightbox__close { top: 1.25rem; right: 1.25rem; }
	.cs-lightbox__prev { left: 1.25rem; top: 50%; transform: translateY(-50%); }
	.cs-lightbox__next { right: 1.25rem; top: 50%; transform: translateY(-50%); }
	@media (max-width: 575.98px) {
		.cs-lightbox__figure { max-width: 100vw; }
		.cs-lightbox__prev, .cs-lightbox__next { top: auto; bottom: 1.25rem; transform: none; }
	}

	.cs-links { margin-top: 0.5rem; }
</style>
