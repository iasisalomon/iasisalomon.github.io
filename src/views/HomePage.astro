---
// The homepage, in either language (src/pages/index.astro, src/pages/es/index.astro).
import MainLayout from '../layouts/MainLayout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import Experience from '../components/Experience.astro';
import SelectedWork from '../components/SelectedWork.astro';
import Skills from '../components/Skills.astro';
import Engineering from '../components/Engineering.astro';
import Writing from '../components/Writing.astro';
import Organizations from '../components/Organizations.astro';
import Testimonials from '../components/Testimonials.astro';
import Contact from '../components/Contact.astro';
import CustomFooter from '../components/CustomFooter.astro';
import { everyLocale, useTranslations, type Locale } from '../i18n';

interface Props {
	lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const alternates = everyLocale('/');
---

<MainLayout title={t('site.title')} description={t('site.description')} lang={lang} alternates={alternates}>
	<Navbar lang={lang} alternates={alternates} />
	<main id="main-content">
		{/* Delivery profile first; deeper work and supporting proof follow. */}
		<Hero lang={lang} />
		<About lang={lang} />
		<Experience lang={lang} />
		<SelectedWork lang={lang} />
		<Engineering lang={lang} />
		<Writing lang={lang} />
		<Skills lang={lang} />
		<Organizations lang={lang} />
		<Testimonials lang={lang} />
		<Contact lang={lang} />
	</main>
	<CustomFooter lang={lang} />
</MainLayout>
