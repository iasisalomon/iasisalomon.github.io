---
import SEO from '../components/SEO.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
// Bootstrap is linked by URL rather than imported: Astro orders imported CSS
// by its own rules (page styles can land first), and every one of our styles
// must come after Bootstrap's to override it.
import bootstrapCss from 'bootstrap/dist/css/bootstrap.min.css?url';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  schemaType?: 'BlogPosting' | 'Article';
  publishedTime?: string;
  modifiedTime?: string;
  noindex?: boolean;
  lang?: string;
}

const {
  title = SITE_TITLE,
  description = SITE_DESCRIPTION,
  image,
  imageAlt,
  type = 'website',
  schemaType,
  publishedTime,
  modifiedTime,
  noindex = false,
  lang = 'en',
} = Astro.props;
---

<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <script is:inline>
      // Runs before first paint so the page never flashes the wrong theme.
      (function () {
        try {
          var stored = localStorage.getItem('theme');
          var theme =
            stored === 'dark' || stored === 'light'
              ? stored
              : window.matchMedia('(prefers-color-scheme: dark)').matches
                ? 'dark'
                : 'light';
          if (theme === 'dark') document.documentElement.setAttribute('data-theme', 'dark');
        } catch (e) {}
      })();
    </script>
    <SEO
      title={title}
      description={description}
      image={image}
      imageAlt={imageAlt}
      type={type}
      schemaType={schemaType}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
      noindex={noindex}
      lang={lang}
    />
    <link rel="stylesheet" href={bootstrapCss} />
    <link rel="icon" href="/assets/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  </head>
  <body>
    <slot />

    <script>
      // Glossary tooltips only appear in a few case studies, so Bootstrap's
      // Tooltip (and Popper) load only on pages that use them.
      const tooltipTriggers = document.querySelectorAll('[data-bs-toggle="tooltip"]');
      if (tooltipTriggers.length) {
        import('bootstrap/js/dist/tooltip').then(({ default: Tooltip }) => {
          tooltipTriggers.forEach((el) => new Tooltip(el));
        });
      }
    </script>
  </body>
</html> 