---
// Blog post page: maps a post's frontmatter onto the shared long-form
// layout (same design as the case studies).
import LongformLayout, { type LongformBadge, type LongformFact } from './LongformLayout.astro';
import { BLOG_CATEGORIES } from '../consts';
import { formatDate, localePath, useTranslations, type Alternates, type Locale } from '../i18n';

interface PostLink {
	title: string;
	href: string;
}

interface Props {
	title: string;
	description: string;
	pubDate: Date;
	updatedDate?: Date;
	heroImage?: string;
	heroImageAlt?: string;
	category?: string;
	lang: Locale;
	/** The post's page in each language it's written in. */
	alternates?: Alternates;
	award?: string;
	readingTime?: string;
	newer?: PostLink;
	older?: PostLink;
}

const {
	title,
	description,
	pubDate,
	updatedDate,
	heroImage,
	heroImageAlt,
	category,
	lang,
	alternates,
	award,
	readingTime,
	newer,
	older,
} = Astro.props;
const t = useTranslations(lang);
const blog = localePath(lang, '/blog/');

const longDate = (date: Date) => formatDate(date, lang, { year: 'numeric', month: 'long', day: 'numeric' });

const categoryKey = BLOG_CATEGORIES.find((c) => c.id === category)?.label;

const badges: LongformBadge[] = [
	...(categoryKey
		? [{ text: t(categoryKey), class: `category-badge category-${category}`, href: `${blog}?category=${category}` }]
		: []),
	...(award ? [{ text: award, class: 'post-badge post-badge--award', icon: 'fa6-solid:trophy' }] : []),
];

const facts: LongformFact[] = [
	{ label: t('blog.published'), value: longDate(pubDate) },
	...(updatedDate ? [{ label: t('blog.updated'), value: longDate(updatedDate) }] : []),
	...(readingTime ? [{ label: t('blog.readingTime'), value: readingTime }] : []),
];
---

<LongformLayout
	title={title}
	description={description}
	image={heroImage}
	imageAlt={heroImageAlt}
	badges={badges}
	facts={facts}
	back={{ href: blog, label: t('blog.back') }}
	prev={newer && { label: t('blog.newer'), ...newer }}
	next={older && { label: t('blog.older'), ...older }}
	publishedTime={pubDate.toISOString()}
	modifiedTime={updatedDate?.toISOString()}
	lang={lang}
	alternates={alternates}
	navVariant="blog"
	activeCategory={category}
>
	<slot />
</LongformLayout>
