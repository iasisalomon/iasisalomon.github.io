---
// Blog post page: maps a post's frontmatter onto the shared long-form
// layout (same design as the case studies).
import LongformLayout, { type LongformBadge, type LongformFact } from './LongformLayout.astro';
import { BLOG_CATEGORIES } from '../consts';
import { languageName } from '../utils/content';

interface PostLink {
	title: string;
	href: string;
}

interface Props {
	title: string;
	description: string;
	pubDate: Date;
	updatedDate?: Date;
	heroImage?: string;
	heroImageAlt?: string;
	category?: string;
	lang?: string;
	award?: string;
	readingTime?: string;
	newer?: PostLink;
	older?: PostLink;
}

const {
	title,
	description,
	pubDate,
	updatedDate,
	heroImage,
	heroImageAlt,
	category,
	lang = 'en',
	award,
	readingTime,
	newer,
	older,
} = Astro.props;

// pubDate is UTC midnight; format in UTC so it doesn't shift a day back.
const formatDate = (date: Date) =>
	date.toLocaleDateString('en-us', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });

const categoryLabel = BLOG_CATEGORIES.find((c) => c.id === category)?.label;
const language = languageName(lang);

const badges: LongformBadge[] = [
	...(categoryLabel
		? [{ text: categoryLabel, class: `category-badge category-${category}`, href: `/blog/?category=${category}` }]
		: []),
	...(language ? [{ text: language, class: 'post-badge' }] : []),
	...(award ? [{ text: award, class: 'post-badge post-badge--award', icon: 'fas fa-trophy' }] : []),
];

const facts: LongformFact[] = [
	{ label: 'Published', value: formatDate(pubDate) },
	...(updatedDate ? [{ label: 'Updated', value: formatDate(updatedDate) }] : []),
	...(readingTime ? [{ label: 'Reading time', value: readingTime }] : []),
];
---

<LongformLayout
	title={title}
	description={description}
	image={heroImage}
	imageAlt={heroImageAlt}
	badges={badges}
	facts={facts}
	back={{ href: '/blog/', label: 'Back to Articles' }}
	prev={newer && { label: 'Newer article', ...newer }}
	next={older && { label: 'Older article', ...older }}
	publishedTime={pubDate.toISOString()}
	modifiedTime={updatedDate?.toISOString()}
	lang={lang}
	navVariant="blog"
	activeCategory={category}
>
	<slot />
</LongformLayout>
