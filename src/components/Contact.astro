---
import { LINKS } from '../consts';

// Let's Talk and Contact used to be two back-to-back sections that both
// listed the email. They're one closing section now.
const offers = [
  {
    icon: 'fas fa-briefcase',
    title: 'Delivery roles',
    text: 'Open to remote Technical Delivery Manager and Technical Program Manager roles with US teams.',
  },
  {
    icon: 'fas fa-unlock',
    title: 'Unblocking teams',
    text: 'Find and remove the people and process bottlenecks that slow delivery.',
  },
  {
    icon: 'fas fa-gears',
    title: 'Automation and AI',
    text: 'Automate intake, onboarding and handoffs with Jira, n8n, Make, Retool or Rewst, and use AI where it saves time.',
  },
];
---

<section id="contact" class="py-6 text-white">
  <div class="container position-relative">
    <div class="text-center mb-5">
      <h2 class="fw-bold mt-1 mb-3">Let's Talk</h2>
      <p class="lead intro mx-auto mb-0">
        Hiring for a delivery role, or need a remote tech team to ship faster? Book a short call and let's see if
        I can help.
      </p>
    </div>

    <div class="row g-3 mb-5">
      {offers.map((o) => (
        <div class="col-md-4">
          <div class="offer h-100 p-4">
            <span class="offer__icon mb-3"><i class={o.icon} aria-hidden="true"></i></span>
            <h3 class="h6 fw-bold mb-2">{o.title}</h3>
            <p class="small mb-0">{o.text}</p>
          </div>
        </div>
      ))}
    </div>

    <div class="cta mx-auto p-4 p-md-5 text-center">
      <a href={LINKS.calendly} class="btn btn-light btn-lg px-5 mb-3" target="_blank" rel="noopener noreferrer">
        <i class="far fa-calendar-alt me-2"></i>Book a 30-minute call
      </a>

      <p class="small muted mb-2">or reach me directly</p>
      <div class="email-row mx-auto mb-4">
        <a href={LINKS.email} class="email-row__address">
          <i class="far fa-envelope me-2"></i>{LINKS.emailAddress}
        </a>
        <button type="button" id="copyEmailBtn" title="Copy email" aria-label="Copy email address" data-email={LINKS.emailAddress}>
          <i class="far fa-copy"></i>
        </button>
      </div>
      <p id="copyConfirmation" class="small copy-confirmation" aria-live="polite"></p>

      <div class="d-flex justify-content-center flex-wrap gap-2">
        <a href={LINKS.linkedin} class="btn btn-outline-light" target="_blank" rel="noopener noreferrer">
          <i class="fab fa-linkedin me-2"></i>LinkedIn
        </a>
        <a href={LINKS.github} class="btn btn-outline-light" target="_blank" rel="noopener noreferrer">
          <i class="fab fa-github me-2"></i>GitHub
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  #contact {
    background: radial-gradient(ellipse at top, #2b3138 0%, #1a1d20 70%);
  }

  .intro {
    max-width: 52ch;
    color: rgba(255, 255, 255, 0.75);
  }

  .offer {
    border-radius: 1rem;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  .offer p {
    color: rgba(255, 255, 255, 0.7);
    line-height: 1.6;
  }

  .offer__icon {
    display: inline-grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 0.6rem;
    color: var(--color-accent-on-dark, #4d9aff);
    background: rgba(77, 154, 255, 0.12);
  }

  .cta {
    max-width: 560px;
    border-radius: 1.25rem;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .muted {
    color: rgba(255, 255, 255, 0.6);
  }

  .email-row {
    display: flex;
    max-width: 340px;
    border-radius: 0.5rem;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.15);
  }

  .email-row__address {
    flex: 1;
    padding: 0.65rem 1rem;
    color: #fff;
    text-decoration: none;
    font-size: 0.95rem;
  }

  .email-row__address:hover {
    background: rgba(255, 255, 255, 0.06);
  }

  #copyEmailBtn {
    padding: 0 1rem;
    border: none;
    border-left: 1px solid rgba(255, 255, 255, 0.15);
    background: rgba(77, 154, 255, 0.15);
    color: var(--color-accent-on-dark, #4d9aff);
    cursor: pointer;
  }

  #copyEmailBtn:hover {
    background: rgba(77, 154, 255, 0.28);
  }

  .copy-confirmation {
    min-height: 1.2em;
    color: #4dff9f;
    margin-top: -0.75rem;
  }
</style>

<script>
  const btn = document.getElementById('copyEmailBtn');
  const note = document.getElementById('copyConfirmation');
  btn?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(btn.dataset.email ?? '');
    } catch {
      return;
    }
    if (!note) return;
    note.textContent = 'Email copied to clipboard';
    setTimeout(() => (note.textContent = ''), 2000);
  });
</script>
