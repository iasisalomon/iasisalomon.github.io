---
import { Icon } from 'astro-icon/components';
import { LINKS } from '../consts';

---

<section id="contact" class="py-6 text-white">
  <div class="container-fluid position-relative">
    <div class="contact-content">
      <div class="contact-copy">
        <h2 class="fw-bold mt-1 mb-3">Let's talk</h2>
        <p class="lead intro mb-0">
          I'm open to remote Technical Delivery Manager and Technical Program Manager roles with US teams. I also take on
          focused workflow-automation engagements.
        </p>
      </div>

      <div class="cta p-4 p-md-5 text-center">
        <a href={LINKS.calendly} class="btn btn-light btn-lg px-5 mb-3" target="_blank" rel="noopener noreferrer">
          <Icon name="fa6-regular:calendar-days" class="me-2" aria-hidden="true" />Book a 30-minute call
        </a>

        <p class="small muted mb-2">Or email me directly</p>
        <div class="email-row mx-auto">
          <a href={LINKS.email} class="email-row__address">
            <Icon name="fa6-regular:envelope" class="me-2" aria-hidden="true" />{LINKS.emailAddress}
          </a>
          <button type="button" id="copyEmailBtn" title="Copy email" aria-label="Copy email address" data-email={LINKS.emailAddress}>
            <Icon name="fa6-regular:copy" aria-hidden="true" />
          </button>
        </div>
        <p id="copyConfirmation" class="small copy-confirmation mb-0" aria-live="polite"></p>
      </div>
    </div>
  </div>
</section>

<style>
  #contact {
    background: radial-gradient(ellipse at top, #2b3138 0%, #1a1d20 70%);
    padding-bottom: 2.5rem;
  }

  .contact-content {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: clamp(2rem, 4vw, 4.5rem);
    align-items: center;
    width: 66.666%;
    max-width: 100%;
    margin-inline: auto;
  }

  .contact-copy {
    text-align: left;
  }

  .intro {
    max-width: 52ch;
    color: rgba(255, 255, 255, 0.75);
  }

  .cta {
    max-width: none;
    border-radius: 1.25rem;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .muted {
    color: rgba(255, 255, 255, 0.6);
  }

  .email-row {
    display: flex;
    max-width: 340px;
    border-radius: 0.5rem;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.15);
  }

  .email-row__address {
    flex: 1;
    padding: 0.65rem 1rem;
    color: #fff;
    text-decoration: none;
    font-size: 0.95rem;
  }

  .email-row__address:hover {
    background: rgba(255, 255, 255, 0.06);
  }

  #copyEmailBtn {
    padding: 0 1rem;
    border: none;
    border-left: 1px solid rgba(255, 255, 255, 0.15);
    background: rgba(77, 154, 255, 0.15);
    color: var(--color-accent-on-dark, #4d9aff);
    cursor: pointer;
  }

  #copyEmailBtn:hover {
    background: rgba(77, 154, 255, 0.28);
  }

  .copy-confirmation {
    min-height: 1.2em;
    color: #4dff9f;
    margin-top: 0.5rem;
  }

  @media (max-width: 1199.98px) {
    .contact-content {
      grid-template-columns: 1fr;
      gap: 2rem;
      width: min(100%, 48rem);
    }

    .contact-copy {
      text-align: center;
    }

    .intro {
      margin-inline: auto;
    }
  }

  @media (max-width: 767.98px) {
    #contact {
      padding-bottom: 2rem;
    }
  }
</style>

<script>
  const btn = document.getElementById('copyEmailBtn');
  const note = document.getElementById('copyConfirmation');
  btn?.addEventListener('click', async () => {
    let message = 'Email copied to clipboard';
    try {
      await navigator.clipboard.writeText(btn.dataset.email ?? '');
    } catch {
      // Clipboard access can be blocked (permissions, insecure context);
      // say so instead of failing silently.
      message = `Couldn't copy — the address is ${btn.dataset.email}`;
    }
    if (!note) return;
    note.textContent = message;
    setTimeout(() => (note.textContent = ''), 4000);
  });
</script>
