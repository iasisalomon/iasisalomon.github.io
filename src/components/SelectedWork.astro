---
import { Icon } from 'astro-icon/components';
import ProjectCard from './ProjectCard.astro';
import { getFeaturedWork } from '../data/queries';
import { localePath, useTranslations, type Locale } from '../i18n';
import { projectCard } from '../utils/projects';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

// The featured projects in src/data/projects.json, each drawn as its `card`
// describes; the rest of the work is in the /projects/ archive.
const work = await getFeaturedWork(lang);
---

<section id="work" class="screen">
  <div class="container">
    <h2 class="text-center mt-1 mb-3">{t('work.title')}</h2>
    <div class="section-divider mb-4"></div>
    <div class="row g-4 justify-content-center swipe-row">
      {work.map((project) => (
        <div class="col-md-6 col-lg-4">
          <ProjectCard {...projectCard(project, lang, { media: true })} />
        </div>
      ))}
    </div>

    <div class="text-center mt-4">
      <a href={localePath(lang, '/projects/')} class="btn btn-outline-dark">{t('work.viewAll')} <Icon name="fa6-solid:arrow-right" class="ms-1" aria-hidden="true" /></a>
    </div>
  </div>
</section>
