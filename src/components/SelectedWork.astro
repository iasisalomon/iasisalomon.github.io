---
import { Icon } from 'astro-icon/components';
import { getFeaturedWork } from '../data/queries';

// Every card has the same anatomy: a visual header (photo, or an area
// gradient with an icon when there's no photo), tag, title, description,
// one row of key facts and a call to action. The cards are the featured
// projects in src/data/projects.json, described by each one's `card`.
interface WorkItem {
  tag: string;
  title: string;
  description: string;
  image?: { src: string; alt: string };
  /** Shown instead of a photo: background class + a brand logo or an astro-icon name. */
  panel?: { gradientClass: string; icon?: string; logo?: string };
  facts: { label: string; items: string[] };
  cta: { label: string; href: string; external?: boolean };
  /** Optional plain link shown next to the main button. */
  link?: { label: string; href: string };
}

const items: WorkItem[] = (await getFeaturedWork()).map(({ slug, title, description, image, card }) => {
  const src = card.image ?? image;
  return {
    tag: card.tag,
    title,
    description: card.description ?? description,
    image: src && !card.panel ? { src, alt: card.imageAlt ?? '' } : undefined,
    panel: card.panel,
    facts: card.facts,
    cta: { label: card.ctaLabel, href: `/projects/${slug}/` },
    link: card.link,
  };
});
---

<section id="work" class="py-6">
  <div class="container">
    <h2 class="text-center mt-1 mb-4">Selected work</h2>
    <div class="section-divider mb-5"></div>
    <div class="row g-4 justify-content-center">
      {items.map((item) => (
        <div class="col-md-6 col-lg-4">
          <article class="work-card h-100 rounded-4 overflow-hidden d-flex flex-column">
            {item.image ? (
              <img src={item.image.src} alt={item.image.alt} loading="lazy" class="work-card__media" />
            ) : (
              item.panel && (
                <div class={`work-card__media work-card__panel ${item.panel.gradientClass}`} aria-hidden="true">
                  {item.panel.logo ? (
                    <img src={item.panel.logo} alt="" class="work-card__logo" />
                  ) : (
                    item.panel.icon && <Icon name={item.panel.icon} />
                  )}
                </div>
              )
            )}
            <div class="p-4 p-lg-5 d-flex flex-column flex-grow-1">
              <p class="work-card__tag mb-2">{item.tag}</p>
              <h3 class="h4 mb-3">{item.title}</h3>
              <p class="work-text flex-grow-1">{item.description}</p>
              <div class="work-card__facts mb-4">
                <span class="work-card__facts-label">{item.facts.label}</span>
                <ul class="list-unstyled d-flex flex-wrap gap-2 mb-0">
                  {item.facts.items.map((fact) => <li class="work-card__chip">{fact}</li>)}
                </ul>
              </div>
              <div class="d-flex flex-wrap align-items-center gap-3">
                <a
                  href={item.cta.href}
                  class="btn btn-primary"
                  {...(item.cta.external && { target: '_blank', rel: 'noopener noreferrer' })}
                >
                  {item.cta.label}
                  <Icon name={item.cta.external ? 'fa6-solid:arrow-up-right-from-square' : 'fa6-solid:arrow-right'} class="ms-2" aria-hidden="true" />
                </a>
                {item.link && (
                  <a href={item.link.href} class="work-card__link" target="_blank" rel="noopener noreferrer">
                    {item.link.label} <Icon name="fa6-solid:arrow-up-right-from-square" class="ms-1" aria-hidden="true" />
                  </a>
                )}
              </div>
            </div>
          </article>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .work-card {
    border: 1px solid var(--color-border, rgba(0, 0, 0, 0.08));
  }

  .work-card__media {
    width: 100%;
    height: 220px;
    object-fit: cover;
  }

  .work-card__panel {
    display: grid;
    place-items: center;
    font-size: 4rem;
    color: rgba(255, 255, 255, 0.9);
    box-shadow: none;
  }

  /* MUBA brand: black with a soft mint glow, as on muba.app. */
  .work-card__panel--muba {
    background: radial-gradient(circle at 50% 45%, rgba(8, 213, 158, 0.28), transparent 60%), #000;
  }

  .work-card__logo {
    height: 180px;
    width: auto;
  }

  .work-card__link {
    color: var(--color-text);
    font-weight: 500;
  }

  .work-card__tag {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
  }

  .work-text {
    color: var(--color-text-secondary);
    line-height: 1.8;
  }

  .work-card__facts {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.75rem;
  }

  .work-card__facts-label {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-heading);
  }

  .work-card__chip {
    font-size: 0.8rem;
    padding: 0.2em 0.7em;
    border-radius: var(--radius-pill, 100px);
    background: var(--color-hover-bg);
    color: var(--color-text);
  }
</style>
