---
import { Icon } from 'astro-icon/components';
import { getCaseStudiesIn, getFeaturedWork } from '../data/queries';
import { useTranslations, type Locale } from '../i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

// Every card has the same anatomy: a visual header (photo, or an area
// gradient with an icon when there's no photo), tag, title, description,
// one row of key facts and a call to action. The cards are the featured
// projects in src/data/projects.json, described by each one's `card`.
interface WorkItem {
  tag: string;
  title: string;
  description: string;
  image?: { src: string; alt: string };
  /** Shown instead of a photo: background class + a brand logo or an astro-icon name. */
  panel?: { gradientClass: string; icon?: string; logo?: string };
  facts: { label: string; items: string[] };
  cta: { label: string; href: string };
  /** Optional plain link shown next to the main button. */
  link?: { label: string; href: string };
}

// Every card opens its case study, so a featured card needs one in this language.
const caseStudyHrefs = new Map((await getCaseStudiesIn(lang)).map((cs) => [cs.slug, cs.href]));

const items: WorkItem[] = (await getFeaturedWork(lang)).map(({ slug, title, description, image, card }) => {
  const href = caseStudyHrefs.get(slug);
  if (!href) throw new Error(`[data] Featured project "${slug}" has a card but no case study in "${lang}".`);
  const src = card.image ?? image;
  return {
    tag: card.tag,
    title,
    description: card.description ?? description,
    image: src && !card.panel ? { src, alt: card.imageAlt ?? '' } : undefined,
    panel: card.panel,
    facts: card.facts,
    cta: { label: card.ctaLabel, href },
    link: card.link,
  };
});
---

<section id="work" class="screen">
  <div class="container">
    <h2 class="text-center mt-1 mb-3">{t('work.title')}</h2>
    <div class="section-divider mb-4"></div>
    <div class="row g-4 justify-content-center swipe-row">
      {items.map((item) => (
        <div class="col-md-6 col-lg-4">
          <article class="work-card position-relative h-100 rounded-4 overflow-hidden d-flex flex-column">
            {item.image ? (
              <img src={item.image.src} alt={item.image.alt} loading="lazy" class="work-card__media" />
            ) : (
              item.panel && (
                <div class={`work-card__media work-card__panel ${item.panel.gradientClass}`} aria-hidden="true">
                  {item.panel.logo ? (
                    <img src={item.panel.logo} alt="" class="work-card__logo" />
                  ) : (
                    item.panel.icon && <Icon name={item.panel.icon} />
                  )}
                </div>
              )
            )}
            <div class="work-card__body">
              <p class="work-card__tag mb-2">{item.tag}</p>
              <h3 class="work-card__title">
                {/* The stretched link makes the whole card clickable while only the title is announced. */}
                <a href={item.cta.href} class="stretched-link">{item.title}</a>
              </h3>
              <p class="work-text">{item.description}</p>
              <p class="work-card__facts">{item.facts.items.join(' · ')}</p>
              <div class="work-card__actions">
                <span class="work-card__cta" aria-hidden="true">
                  {item.cta.label} <Icon name="fa6-solid:arrow-right" class="ms-1" />
                </span>
                {item.link && (
                  <a href={item.link.href} class="work-card__link" target="_blank" rel="noopener noreferrer">
                    {item.link.label} <Icon name="fa6-solid:arrow-up-right-from-square" class="ms-1" aria-hidden="true" />
                  </a>
                )}
              </div>
            </div>
          </article>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  /* A calm card: picture, tag, title, three lines of text, one line of
     facts and a text link. The whole card opens the case study. */
  .work-card {
    border: 1px solid var(--color-border);
    background: var(--color-card);
    transition: border-color 0.2s ease;
  }

  .work-card:hover {
    border-color: var(--color-border-strong);
  }

  .work-card__media {
    width: 100%;
    height: 175px;
    object-fit: cover;
  }

  .work-card__panel {
    display: grid;
    place-items: center;
    font-size: 4rem;
    color: rgba(255, 255, 255, 0.9);
    box-shadow: none;
  }

  /* MUBA brand: black with a soft mint glow, as on muba.app. */
  .work-card__panel--muba {
    background: radial-gradient(circle at 50% 45%, rgba(8, 213, 158, 0.28), transparent 60%), #000;
  }

  .work-card__logo {
    height: 140px;
    width: auto;
  }

  .work-card__body {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    padding: 1.35rem 1.5rem 1.5rem;
  }

  .work-card__tag {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
  }

  .work-card__title {
    font-size: 1.2rem;
    margin-bottom: 0.6rem;
  }

  .work-card__title a {
    color: var(--color-heading);
    transition: color 0.2s ease;
  }

  .work-card:hover .work-card__title a {
    color: var(--color-accent);
  }

  /* Up to five lines here; the full story is in the case study. */
  .work-text {
    color: var(--color-text-secondary);
    font-size: 0.9rem;
    line-height: 1.6;
    margin-bottom: 0.9rem;
    display: -webkit-box;
    -webkit-line-clamp: 5;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .work-card__facts {
    font-size: 0.78rem;
    color: var(--color-text-muted);
    margin-bottom: 1.1rem;
    flex-grow: 1;
  }

  .work-card__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 1.1rem;
    font-size: 0.88rem;
    font-weight: 600;
    white-space: nowrap;
  }

  .work-card__cta {
    color: var(--color-accent);
  }

  .work-card__cta :global(svg) {
    transition: transform 0.2s ease;
  }

  .work-card:hover .work-card__cta :global(svg) {
    transform: translateX(3px);
  }

  /* Sits above the stretched link so it opens its own page. */
  .work-card__link {
    position: relative;
    z-index: 2;
    color: var(--color-text-secondary);
    font-weight: 500;
  }

  .work-card__link:hover {
    color: var(--color-heading);
  }
</style>
