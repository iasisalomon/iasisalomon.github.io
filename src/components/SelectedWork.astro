---
import { getProjectBySlug } from '../data/portfolio';

const axiecon = getProjectBySlug('axiecon-barcelona')!;
---

<section id="work" class="py-6">
  <div class="container">
    <h2 class="text-center mt-1 mb-4">Selected work</h2>
    <div class="section-divider mb-5"></div>
    <div class="row g-4 justify-content-center">
      <div class="col-lg-6">
        <article class="work-card h-100 rounded-4 overflow-hidden d-flex flex-column">
          <img src={axiecon.image} alt={axiecon.title} loading="lazy" class="work-card__img" />
          <div class="p-4 p-lg-5 d-flex flex-column flex-grow-1">
            <p class="work-card__tag mb-2">Live event · Sky Mavis</p>
            <h3 class="h4 mb-3">{axiecon.title}</h3>
            <p class="work-text flex-grow-1">{axiecon.description}</p>
            <div>
              <a href={`/projects/${axiecon.slug}/`} class="btn btn-primary mt-2">
                Read the story <i class="fas fa-arrow-right ms-2"></i>
              </a>
            </div>
          </div>
        </article>
      </div>

      <div class="col-lg-6">
        <article class="work-card h-100 rounded-4 overflow-hidden d-flex flex-column">
          <div class="p-4 p-lg-5 d-flex flex-column flex-grow-1">
            <p class="work-card__tag mb-2">Startup · Building with partners</p>
            <h3 class="h4 mb-3">MUBA</h3>
            <p class="work-text">
              Multi-tenant SaaS for nursing-home management in Argentina, covering resident records, billing and
              settlements with health insurers, and an offline-capable nursing log. I wrote the functional spec,
              set the architecture and scope, and directed the AI-assisted development end to end.
            </p>
            <p class="work-text flex-grow-1"><strong>Stack:</strong> React, Node.js, PostgreSQL (Prisma), Redis.</p>
            <div>
              <a href="https://demo.muba.lat" class="btn btn-primary mt-2" target="_blank" rel="noopener noreferrer">
                View live demo <i class="fas fa-arrow-up-right-from-square ms-2"></i>
              </a>
            </div>
          </div>
        </article>
      </div>
    </div>
  </div>
</section>

<style>
  .work-card {
    border: 1px solid var(--color-border, rgba(0, 0, 0, 0.08));
  }

  .work-card__img {
    width: 100%;
    height: 220px;
    object-fit: cover;
  }

  .work-card__tag {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
  }

  .work-text {
    color: var(--color-text-secondary);
    line-height: 1.8;
  }
</style>
