---
import { getCollection } from 'astro:content';
import { BLOG_CATEGORIES } from '../consts';
import { languageName, readingTime } from '../utils/content';

// Latest posts as a teaser; the full archive lives at /blog.
const posts = (await getCollection('blog'))
  .sort((a, b) => new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf())
  .slice(0, 3);

const categoryLabels: Record<string, string> = Object.fromEntries(
  BLOG_CATEGORIES.map((c) => [c.id, c.label]),
);
---

<section id="blog" class="py-6">
  <div class="container">
    <h2 class="text-center mt-1 mb-2">Writing archive</h2>
    <p class="text-center text-muted mb-4">Selected older essays and reflections; each article shows its original date.</p>
    <div class="section-divider mb-5"></div>

    <div class="row g-4 justify-content-center">
      {posts.map((post) => (
        <div class="col-md-6 col-lg-4">
          <a href={`/blog/${post.id}/`} class="writing-card h-100 d-flex flex-column bg-white rounded-4 overflow-hidden text-reset">
            <div class="writing-img">
              <img src={post.data.heroImage || '/images/og-default.jpg'} alt={post.data.title} loading="lazy" />
            </div>
            <div class="p-4 d-flex flex-column flex-grow-1">
              <div class="d-flex flex-wrap align-items-center gap-2 mb-2 small text-muted">
                {post.data.pubDate && (
                  <time datetime={post.data.pubDate.toISOString()}>
                    {post.data.pubDate.toLocaleDateString('en-us', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' })}
                  </time>
                )}
                {post.data.category && (
                  <span class={`category-badge category-${post.data.category}`}>
                    {categoryLabels[post.data.category] ?? post.data.category}
                  </span>
                )}
                {languageName(post.data.lang) && <span class="post-badge">{languageName(post.data.lang)}</span>}
                <span>{readingTime(post.body)}</span>
              </div>
              <h3 class="h5 fw-bold mb-2" lang={post.data.lang}>{post.data.title}</h3>
              {post.data.award && (
                <p class="post-badge post-badge--award align-self-start mb-2">
                  <i class="fas fa-trophy me-1" aria-hidden="true"></i>{post.data.award}
                </p>
              )}
              <p class="text-muted small mb-3 flex-grow-1" lang={post.data.lang}>{post.data.description}</p>
              <span class="read-cta fw-medium small">Read article <i class="fas fa-arrow-right ms-1"></i></span>
            </div>
          </a>
        </div>
      ))}
    </div>

    <div class="text-center mt-4">
      <a href="/blog" class="btn btn-outline-dark">View all articles <i class="fas fa-arrow-right ms-1"></i></a>
    </div>
  </div>
</section>

<style>
  .writing-card {
    text-decoration: none;
    border: 1px solid var(--color-border, rgba(0, 0, 0, 0.08));
    box-shadow: 0 0.4rem 1.2rem rgba(0, 0, 0, 0.05);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .writing-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 1rem 2.5rem rgba(0, 0, 0, 0.12);
  }

  .writing-img {
    height: 170px;
    overflow: hidden;
  }

  .writing-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .writing-card:hover .writing-img img {
    transform: scale(1.05);
  }

  .read-cta {
    color: var(--color-accent, #0d6efd);
  }

  .read-cta i {
    transition: transform 0.2s ease;
  }

  .writing-card:hover .read-cta i {
    transform: translateX(4px);
  }

  @media (prefers-reduced-motion: reduce) {
    .writing-card:hover { transform: none; }
    .writing-card:hover .writing-img img { transform: none; }
  }
</style>
