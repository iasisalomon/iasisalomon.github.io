---
import { Icon } from 'astro-icon/components';
import { BLOG_CATEGORIES } from '../consts';
import { getPostList } from '../data/queries';
import { formatDate, localePath, pick, useTranslations, type Locale } from '../i18n';
import { languageName, readingTime } from '../utils/content';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

// Latest posts as a teaser; the full archive lives at /blog. Posts not
// written in this language are listed in the one they were written in.
const posts = (await getPostList(lang)).slice(0, 3);

const categoryLabels: Record<string, string> = Object.fromEntries(
  BLOG_CATEGORIES.map((c) => [c.id, t(c.label)]),
);
---

<section id="blog" class="py-6">
  <div class="container">
    <h2 class="text-center mt-1 mb-2">{t('writing.title')}</h2>
    <p class="text-center text-muted mb-4">{t('writing.subtitle')}</p>
    <div class="section-divider mb-5"></div>

    <div class="row g-4 justify-content-center">
      {posts.map(({ entry: post, lang: postLang, href }) => (
        <div class="col-md-6 col-lg-4">
          <article class="writing-card position-relative h-100 d-flex flex-column bg-white rounded-4 overflow-hidden">
            <div class="writing-img">
              <img src={post.data.heroImage || '/images/og-default.jpg'} alt="" loading="lazy" />
            </div>
            <div class="p-4 d-flex flex-column flex-grow-1">
              <div class="d-flex flex-wrap align-items-center gap-2 mb-2 small text-muted">
                {post.data.pubDate && (
                  <time datetime={post.data.pubDate.toISOString()}>
                    {formatDate(post.data.pubDate, lang, { year: 'numeric', month: 'short', day: 'numeric' })}
                  </time>
                )}
                {post.data.category && (
                  <span class={`category-badge category-${post.data.category}`}>
                    {categoryLabels[post.data.category] ?? post.data.category}
                  </span>
                )}
                {languageName(postLang, lang) && <span class="post-badge" lang={postLang}>{languageName(postLang, lang)}</span>}
                <span>{readingTime(post.body, lang)}</span>
              </div>
              <h3 class="h5 fw-bold mb-2" lang={postLang}>
                {/* The stretched link makes the whole card clickable while only the title is announced. */}
                <a href={href} hreflang={postLang} class="stretched-link text-reset">{post.data.title}</a>
              </h3>
              {post.data.award && (
                <p class="post-badge post-badge--award align-self-start mb-2">
                  <Icon name="fa6-solid:trophy" class="me-1" aria-hidden="true" />{pick(post.data.award, lang)}
                </p>
              )}
              <p class="text-muted small mb-3 flex-grow-1" lang={postLang}>{post.data.description}</p>
              <span class="read-cta fw-medium small" aria-hidden="true">{t('writing.readArticle')} <Icon name="fa6-solid:arrow-right" class="ms-1" aria-hidden="true" /></span>
            </div>
          </article>
        </div>
      ))}
    </div>

    <div class="text-center mt-4">
      <a href={localePath(lang, '/blog/')} class="btn btn-outline-dark">{t('writing.viewAll')} <Icon name="fa6-solid:arrow-right" class="ms-1" aria-hidden="true" /></a>
    </div>
  </div>
</section>

<style>
  .writing-card {
    text-decoration: none;
    border: 1px solid var(--color-border, rgba(0, 0, 0, 0.08));
    box-shadow: 0 0.4rem 1.2rem rgba(0, 0, 0, 0.05);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .writing-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 1rem 2.5rem rgba(0, 0, 0, 0.12);
  }

  .writing-img {
    height: 170px;
    overflow: hidden;
  }

  .writing-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .writing-card:hover .writing-img img {
    transform: scale(1.05);
  }

  .read-cta {
    color: var(--color-accent, #0d6efd);
  }

  .read-cta svg {
    transition: transform 0.2s ease;
  }

  .writing-card:hover .read-cta svg {
    transform: translateX(4px);
  }

  @media (prefers-reduced-motion: reduce) {
    .writing-card:hover { transform: none; }
    .writing-card:hover .writing-img img { transform: none; }
  }
</style>
