---
import { Icon } from 'astro-icon/components';
import { DEFAULT_IMAGE } from '../consts';
import { getPostList } from '../data/queries';
import { localePath, pick, useTranslations, type Locale } from '../i18n';
import { cardAward, categoryLabels, languageName, readingTime, shortDate } from '../utils/content';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

// Latest posts as a teaser; the full archive lives at /blog. Posts not
// written in this language are listed in the one they were written in.
const posts = (await getPostList(lang)).slice(0, 3);

const labels = categoryLabels(lang);
---

<section id="blog" class="screen">
  <div class="container">
    <h2 class="text-center mt-1 mb-2">{t('writing.title')}</h2>
    <p class="text-center text-muted mb-4">{t('writing.subtitle')}</p>
    <div class="section-divider mb-4"></div>

    <div class="row g-4 justify-content-center swipe-row">
      {posts.map(({ entry: post, lang: postLang, href }) => (
        <div class={posts.length === 2 ? 'col-md-6' : 'col-md-6 col-lg-4'}>
          <article class="writing-card position-relative h-100 d-flex flex-column bg-white rounded-4 overflow-hidden">
            <div class="writing-img">
              <img src={post.data.heroImage ?? DEFAULT_IMAGE} alt="" loading="lazy" />
            </div>
            <div class="px-4 py-3 d-flex flex-column flex-grow-1">
              <div class="d-flex flex-wrap align-items-center gap-2 mb-2 small text-muted">
                <time datetime={post.data.pubDate.toISOString()}>{shortDate(post.data.pubDate, lang)}</time>
                {post.data.category && (
                  <span class={`category-badge category-${post.data.category}`}>
                    {labels[post.data.category]}
                  </span>
                )}
                {languageName(postLang, lang) && <span class="post-badge" lang={postLang}>{languageName(postLang, lang)}</span>}
                <span>{readingTime(post.body, lang)}</span>
              </div>
              <h3 class="h5 fw-bold mb-2" lang={postLang}>
                {/* The stretched link makes the whole card clickable while only the title is announced. */}
                <a href={href} hreflang={postLang} class="stretched-link text-reset">{post.data.title}</a>
              </h3>
              {post.data.award && (
                <p class="award-note mb-2">
                  <Icon name="fa6-solid:trophy" aria-hidden="true" />
                  <span>{cardAward(pick(post.data.award, lang))}</span>
                </p>
              )}
              <p class="text-muted small mb-3 flex-grow-1" lang={postLang}>{post.data.description}</p>
              <span class="read-cta fw-medium small" aria-hidden="true">{t('writing.readArticle')} <Icon name="fa6-solid:arrow-right" class="ms-1" aria-hidden="true" /></span>
            </div>
          </article>
        </div>
      ))}
    </div>

    <div class="text-center mt-4">
      <a href={localePath(lang, '/blog/')} class="btn btn-outline-dark">{t('writing.viewAll')} <Icon name="fa6-solid:arrow-right" class="ms-1" aria-hidden="true" /></a>
    </div>
  </div>
</section>

<style>
  /* Same anatomy as the Work cards: a bordered card, no floating shadow;
     hover only sharpens the border and nudges the image. */
  .writing-card {
    text-decoration: none;
    border: 1px solid var(--color-border);
    transition: border-color 0.2s ease;
  }

  .writing-card:hover {
    border-color: var(--color-border-strong);
  }

  .writing-img {
    height: 125px;
    overflow: hidden;
  }

  .writing-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .writing-card:hover .writing-img img {
    transform: scale(1.04);
  }

  .read-cta {
    color: var(--color-accent);
  }

  /* :global because the icon is rendered by astro-icon, outside this
     component's style scope. */
  .read-cta :global(svg) {
    transition: transform 0.2s ease;
  }

  .writing-card:hover .read-cta :global(svg) {
    transform: translateX(4px);
  }

  @media (prefers-reduced-motion: reduce) {
    .writing-card:hover .writing-img img { transform: none; }
  }
</style>
