---
import { useTranslations, type Locale } from '../i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const groups = [
  { name: t('skills.deliveryName'), items: t('skills.deliveryItems') },
  { name: t('skills.toolingName'), items: t('skills.toolingItems') },
  { name: t('skills.technicalName'), items: t('skills.technicalItems') },
];
---

{/* Rendered inside the About screen; keeps its own anchor for old links. */}
<div id="skills" class="skills">
  <h3 class="skills__title">{t('skills.title')}</h3>
  <dl class="mb-0">
    {groups.map((g) => (
      <div class="skill-line">
        <dt>{g.name}</dt>
        <dd>{g.items}</dd>
      </div>
    ))}
  </dl>
</div>

<style>
  .skills {
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
  }

  .skills__title {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
    margin-bottom: 0.75rem;
  }

  .skill-line {
    display: grid;
    grid-template-columns: 12rem minmax(0, 1fr);
    gap: 0.25rem 1rem;
    margin-bottom: 0.5rem;
    font-size: 0.92rem;
    line-height: 1.6;
  }

  .skill-line dt {
    color: var(--color-heading);
    font-weight: 600;
  }

  .skill-line dd {
    color: var(--color-text-secondary);
    margin: 0;
  }

  @media (max-width: 767.98px) {
    .skill-line {
      grid-template-columns: 1fr;
      margin-bottom: 0.75rem;
    }
  }
</style>
