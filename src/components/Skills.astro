---
import { useTranslations, type Locale } from '../i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

// Each group's items are one comma-separated string in the dictionaries;
// shown as tags here. Commas inside parentheses stay put, so
// "Jira (JQL, automation)" is one tag.
const tags = (list: string) =>
  list
    .replace(/\.\s*$/, '')
    .split(/,\s*(?![^(]*\))/)
    .filter(Boolean);

const groups = [
  { name: t('skills.deliveryName'), items: tags(t('skills.deliveryItems')) },
  { name: t('skills.toolingName'), items: tags(t('skills.toolingItems')) },
  { name: t('skills.technicalName'), items: tags(t('skills.technicalItems')) },
];
---

{/* The bottom band of the About screen; keeps its own anchor for old links. */}
<div id="skills" class="skills">
  <h3 class="visually-hidden">{t('skills.title')}</h3>
  {groups.map((g) => (
    <div class="skills__group">
      <h4 class="skills__name">{g.name}</h4>
      <ul class="skills__tags list-unstyled mb-0">
        {g.items.map((item) => <li>{item}</li>)}
      </ul>
    </div>
  ))}
</div>

<style>
  .skills {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
  }

  .skills__name {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
    margin-bottom: 0.6rem;
  }

  .skills__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .skills__tags li {
    font-size: 0.76rem;
    padding: 0.18em 0.65em;
    border-radius: var(--radius-pill);
    background: var(--color-hover-bg);
    color: var(--color-text);
    white-space: nowrap;
  }

  @media (max-width: 767.98px) {
    .skills {
      grid-template-columns: 1fr;
      gap: 1.1rem;
    }
  }
</style>
