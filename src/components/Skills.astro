---
import { useTranslations, type Locale } from '../i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const groups = [
  { name: t('skills.deliveryName'), items: t('skills.deliveryItems') },
  { name: t('skills.toolingName'), items: t('skills.toolingItems') },
  { name: t('skills.technicalName'), items: t('skills.technicalItems') },
];
---

<section id="skills" class="py-6 bg-light">
  <div class="container">
    <h2 class="text-center mt-1 mb-4">{t('skills.title')}</h2>
    <div class="section-divider mb-5"></div>
    <div class="row justify-content-center">
      <div class="col-lg-8">
        {groups.map((g) => (
          <p class="skill-line">
            <strong>{g.name}:</strong> {g.items}
          </p>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .skill-line {
    color: var(--color-text-secondary);
    line-height: 1.8;
  }

  .skill-line strong {
    color: var(--color-heading);
  }
</style>
