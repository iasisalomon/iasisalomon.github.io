---
import { useTranslations, type Locale } from '../i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const groups = [
  { name: t('skills.deliveryName'), items: t('skills.deliveryItems') },
  { name: t('skills.toolingName'), items: t('skills.toolingItems') },
  { name: t('skills.technicalName'), items: t('skills.technicalItems') },
];
---

{/* The right column of the About screen; keeps its own anchor for old links. */}
<div id="skills" class="skills">
  <h3 class="skills__title">{t('skills.title')}</h3>
  <dl class="mb-0">
    {groups.map((g) => (
      <div class="skill-line">
        <dt>{g.name}</dt>
        <dd>{g.items}</dd>
      </div>
    ))}
  </dl>
</div>

<style>
  .skills {
    padding: 1.25rem 1.4rem;
    border: 1px solid var(--color-border);
    border-radius: 1rem;
    background: var(--color-card);
  }

  .skills__title {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
    margin-bottom: 0.75rem;
  }

  .skill-line {
    margin-bottom: 0.85rem;
    font-size: 0.9rem;
    line-height: 1.55;
  }

  .skill-line:last-child {
    margin-bottom: 0;
  }

  .skill-line dt {
    color: var(--color-heading);
    font-weight: 600;
  }

  .skill-line dd {
    color: var(--color-text-secondary);
    margin: 0;
  }

  @media (max-width: 767.98px) {
    .skills {
      padding: 1rem 1.1rem;
    }
  }
</style>
