---
import { LINKS } from '../consts';
---

<section id="home" class="d-flex flex-column bg-dark text-white">
  <div class="container text-center py-5">
    <div class="profile-image mb-4">
      <img
        src="/images/cara.jpg"
        alt="Iasi Salomon"
        class="rounded-circle img-fluid shadow-lg"
        width="160"
        height="160"
      />
    </div>
    <p class="name mb-2">Iasi Salomon</p>
    <h1 class="headline mx-auto mb-3">I unblock remote engineering teams, and automate what keeps them stuck.</h1>
    <p class="role mb-4">Technical Delivery Manager · Delivery operations, automation &amp; AI · Remote, US time zones</p>

    <div class="hero-ctas">
      <a href={LINKS.linkedin} class="btn btn-light btn-lg m-1" target="_blank" rel="noopener noreferrer">
        <i class="fab fa-linkedin me-2"></i>LinkedIn
      </a>
      <a href={LINKS.email} class="btn btn-outline-light btn-lg m-1">
        <i class="fas fa-envelope me-2"></i>Email
      </a>
      <a href={LINKS.github} class="btn btn-outline-light btn-lg m-1" target="_blank" rel="noopener noreferrer">
        <i class="fab fa-github me-2"></i>GitHub
      </a>
    </div>
  </div>
</section>

<style>
  #home {
    padding-top: 76px;
    min-height: 70vh;
    justify-content: center;
  }

  .profile-image img {
    border: 4px solid rgba(255, 255, 255, 0.2);
  }

  .role {
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--color-accent-on-dark, #4d9aff);
  }

  .name {
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.7);
  }

  .headline {
    max-width: 22ch;
    font-size: clamp(2rem, 5vw, 3.25rem);
    font-weight: 700;
    line-height: 1.15;
  }

  @media (max-width: 768px) {
    #home {
      padding-top: 60px;
    }

    .profile-image img {
      width: 130px;
      height: 130px;
    }

    .role {
      font-size: 0.95rem;
    }
  }
</style>
