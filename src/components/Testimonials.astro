---
import { Icon } from 'astro-icon/components';
import { getTestimonials } from '../data/queries';

const testimonials = await getTestimonials();
const featuredTestimonials = testimonials.filter((t) => t.featured);
const additionalTestimonials = testimonials.filter((t) => !t.featured);

const initials = (name: string) =>
  name
    .split(' ')
    .map((w) => w[0])
    .slice(0, 2)
    .join('');
---

{testimonials.length > 0 && (
<section id="testimonials" class="py-6 bg-light">
  <div class="container">
    <h2 class="text-center mt-1 mb-4">What colleagues say</h2>
    <div class="section-divider mb-5"></div>

    <div class="quotes" role="list">
      {featuredTestimonials.map((t) => (
        <figure class="quote" role="listitem">
          <Icon name="fa6-solid:quote-left" class="quote__mark" aria-hidden="true" />
          <blockquote>{t.quote}</blockquote>
          <figcaption>
            <span class="quote__avatar" aria-hidden="true">{initials(t.name)}</span>
            <span>
              <strong>{t.name}</strong>
              <span class="quote__role">{t.role}{t.org ? `, ${t.org}` : ''}</span>
            </span>
          </figcaption>
        </figure>
      ))}
    </div>
    {additionalTestimonials.length > 0 && (
      <details class="quotes-more">
        <summary>Read {additionalTestimonials.length} more colleague recommendations</summary>
        <div class="quotes quotes--more" role="list">
          {additionalTestimonials.map((t) => (
            <figure class="quote" role="listitem">
              <Icon name="fa6-solid:quote-left" class="quote__mark" aria-hidden="true" />
              <blockquote>{t.quote}</blockquote>
              <figcaption>
                <span class="quote__avatar" aria-hidden="true">{initials(t.name)}</span>
                <span>
                  <strong>{t.name}</strong>
                  <span class="quote__role">{t.role}{t.org ? `, ${t.org}` : ''}</span>
                </span>
              </figcaption>
            </figure>
          ))}
        </div>
      </details>
    )}
  </div>
</section>
)}

<style>
  .quotes {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .quote {
    margin: 0;
    padding: 1.5rem;
    border-radius: 1rem;
    border: 1px solid var(--color-border, rgba(0, 0, 0, 0.08));
    background: var(--color-card, #fff);
  }

  .quote__mark {
    color: var(--color-accent, #0d6efd);
    opacity: 0.5;
    font-size: 1.1rem;
    margin-bottom: 0.6rem;
  }

  .quote blockquote {
    font-size: 0.98rem;
    line-height: 1.65;
    color: var(--color-text-secondary);
    margin-bottom: 1rem;
  }

  .quote figcaption {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.85rem;
  }

  .quote figcaption strong {
    display: block;
    color: var(--color-heading);
  }

  .quote__role {
    color: var(--color-text-secondary);
  }

  .quote__avatar {
    flex: 0 0 auto;
    display: grid;
    place-items: center;
    width: 2.4rem;
    height: 2.4rem;
    border-radius: 50%;
    font-weight: 700;
    font-size: 0.8rem;
    color: #fff;
    background: var(--color-accent, #0d6efd);
  }

  .quotes-more {
    margin-top: 1.25rem;
  }

  .quotes-more summary {
    display: inline-block;
    color: var(--color-accent, #0d6efd);
    cursor: pointer;
    font-weight: 600;
    padding: 0.35rem 0;
  }

  .quotes-more[open] .quotes {
    margin-top: 1rem;
  }

  @media (max-width: 767.98px) {
    .quotes {
      grid-template-columns: 1fr;
    }
  }
</style>
