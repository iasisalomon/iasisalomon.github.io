---
import proof from '../data/proof.json';
import partnerBrands from '../data/partnerBrands.json';

const { testimonials } = proof as {
  testimonials: { quote: string; name: string; role: string; org?: string }[];
};

type PartnerBrand = {
  name: string;
  logo: string;
  darkTile?: boolean;
  url?: string;
  group: 'work' | 'esports';
};

const brands = partnerBrands as PartnerBrand[];
const groups = [
  { label: 'Companies', items: brands.filter((b) => b.group === 'work') },
  { label: 'Esports and events', items: brands.filter((b) => b.group === 'esports') },
];

const initials = (name: string) =>
  name
    .split(' ')
    .map((w) => w[0])
    .slice(0, 2)
    .join('');
---

<section id="proof" class="py-6">
  <div class="container">
    <h2 class="text-center mt-1 mb-4">Worked With</h2>
    <div class="section-divider mb-5"></div>

    {groups.map((group) => (
      <div class="logo-group">
        <p class="logo-group__label">{group.label}</p>
        <ul class="logo-grid list-unstyled">
          {group.items.map((brand) => (
            <li>
              <a
                class:list={['logo-tile', { 'logo-tile--dark': brand.darkTile }]}
                href={brand.url}
                target="_blank"
                rel="noopener noreferrer"
                title={brand.name}
                aria-label={`${brand.name} (opens in a new tab)`}
              >
                <img src={brand.logo} alt={`${brand.name} logo`} loading="lazy" decoding="async" width="140" height="56" />
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))}

    {testimonials.length > 0 && (
      <>
        <h3 class="text-center h4 mt-5 mb-4">What colleagues say</h3>
        <div class="quotes" role="list">
          {testimonials.map((t) => (
            <figure class="quote" role="listitem">
              <i class="fas fa-quote-left quote__mark" aria-hidden="true"></i>
              <blockquote>{t.quote}</blockquote>
              <figcaption>
                <span class="quote__avatar" aria-hidden="true">{initials(t.name)}</span>
                <span>
                  <strong>{t.name}</strong>
                  <span class="quote__role">{t.role}{t.org ? `, ${t.org}` : ''}</span>
                </span>
              </figcaption>
            </figure>
          ))}
        </div>
      </>
    )}
  </div>
</section>

<style>
  /* ---------- Logos ---------- */
  .logo-group {
    max-width: 900px;
    margin: 0 auto 1.75rem;
  }

  .logo-group__label {
    text-align: center;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
    margin-bottom: 0.75rem;
  }

  .logo-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin: 0;
  }

  /* Every tile is the same size and shape; the dark variant exists only for
     white logos that would disappear on a light tile. */
  .logo-tile {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 9.5rem;
    height: 4.5rem;
    padding: 0.8rem 1rem;
    border-radius: 0.75rem;
    background: #fff;
    border: 1px solid var(--color-border, rgba(0, 0, 0, 0.08));
  }

  .logo-tile--dark {
    background: #212529;
    border-color: rgba(255, 255, 255, 0.1);
  }

  /* Muted by default so the row reads as one set; full colour on hover. */
  .logo-tile img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    filter: grayscale(1);
    opacity: 0.7;
    transition: filter 0.2s ease, opacity 0.2s ease;
  }

  .logo-tile:hover img,
  .logo-tile:focus-visible img {
    filter: none;
    opacity: 1;
  }

  .logo-tile:focus-visible {
    outline: 2px solid var(--color-accent, #4d9aff);
    outline-offset: 3px;
  }

  /* ---------- Testimonials ---------- */
  .quotes {
    columns: 3 300px;
    column-gap: 1.25rem;
  }

  .quote {
    break-inside: avoid;
    margin: 0 0 1.25rem;
    padding: 1.5rem;
    border-radius: 1rem;
    border: 1px solid var(--color-border, rgba(0, 0, 0, 0.08));
    background: var(--color-surface, transparent);
  }

  .quote__mark {
    color: var(--color-accent, #0d6efd);
    opacity: 0.5;
    font-size: 1.1rem;
    margin-bottom: 0.6rem;
  }

  .quote blockquote {
    font-size: 0.98rem;
    line-height: 1.65;
    color: var(--color-text-secondary);
    margin-bottom: 1rem;
  }

  .quote figcaption {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.85rem;
  }

  .quote figcaption strong {
    display: block;
    color: var(--color-heading);
  }

  .quote__role {
    color: var(--color-text-secondary);
  }

  .quote__avatar {
    flex: 0 0 auto;
    display: grid;
    place-items: center;
    width: 2.4rem;
    height: 2.4rem;
    border-radius: 50%;
    font-weight: 700;
    font-size: 0.8rem;
    color: #fff;
    background: var(--color-accent, #0d6efd);
  }

  /* Phones: a swipeable row instead of eight stacked cards. */
  @media (max-width: 767.98px) {
    .logo-tile {
      width: 8rem;
      height: 4rem;
    }

    .quotes {
      columns: auto;
      display: flex;
      gap: 1rem;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: thin;
      padding-bottom: 0.75rem;
      margin: 0 -0.75rem;
      padding-left: 0.75rem;
      padding-right: 0.75rem;
    }

    .quote {
      flex: 0 0 85%;
      scroll-snap-align: center;
      margin: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .logo-tile img {
      transition: none;
    }
  }
</style>
