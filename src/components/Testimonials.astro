---
import proof from '../data/proof.json';
import partnerBrands from '../data/partnerBrands.json';

const { testimonials } = proof as {
  testimonials: { quote: string; name: string; role: string; org?: string }[];
};

type PartnerBrand = {
  name: string;
  logo: string;
  darkTile?: boolean;
  url?: string;
};

const brands = partnerBrands as PartnerBrand[];
const featuredBrandNames = new Set(['Home Team Network', 'Interlaced', 'Sky Mavis']);
const featuredBrands = brands.filter((brand) => featuredBrandNames.has(brand.name));
const additionalBrands = brands.filter((brand) => !featuredBrandNames.has(brand.name));
const featuredTestimonials = testimonials.slice(0, 4);
const additionalTestimonials = testimonials.slice(4);

const initials = (name: string) =>
  name
    .split(' ')
    .map((w) => w[0])
    .slice(0, 2)
    .join('');
---

<section id="proof" class="py-6">
  <div class="container">
    <h2 class="text-center mt-1 mb-4">Teams and organizations</h2>
    <div class="section-divider mb-5"></div>

    <div class="logo-group">
      <ul class="logo-grid logo-grid--featured list-unstyled">
        {featuredBrands.map((brand) => (
          <li>
            <a
              class:list={['logo-tile', 'logo-tile--featured', { 'logo-tile--dark': brand.darkTile }]}
              href={brand.url}
              target="_blank"
              rel="noopener noreferrer"
              title={brand.name}
              aria-label={`${brand.name} (opens in a new tab)`}
            >
              <img src={brand.logo} alt={`${brand.name} logo`} loading="lazy" decoding="async" width="180" height="72" />
            </a>
          </li>
        ))}
      </ul>
    </div>

    {additionalBrands.length > 0 && (
      <div class="logo-group logo-group--additional">
        <ul class="logo-grid logo-grid--additional list-unstyled">
          {additionalBrands.map((brand) => (
            <li>
              <a
                class:list={['logo-tile', 'logo-tile--additional', { 'logo-tile--dark': brand.darkTile }]}
                href={brand.url}
                target="_blank"
                rel="noopener noreferrer"
                title={brand.name}
                aria-label={`${brand.name} (opens in a new tab)`}
              >
                <img src={brand.logo} alt={`${brand.name} logo`} loading="lazy" decoding="async" width="140" height="56" />
              </a>
            </li>
          ))}
        </ul>
      </div>
    )}

    {testimonials.length > 0 && (
      <>
        <h3 class="text-center h4 mt-5 mb-4">What colleagues say</h3>
        <div class="quotes" role="list">
          {featuredTestimonials.map((t) => (
            <figure class="quote" role="listitem">
              <i class="fas fa-quote-left quote__mark" aria-hidden="true"></i>
              <blockquote>{t.quote}</blockquote>
              <figcaption>
                <span class="quote__avatar" aria-hidden="true">{initials(t.name)}</span>
                <span>
                  <strong>{t.name}</strong>
                  <span class="quote__role">{t.role}{t.org ? `, ${t.org}` : ''}</span>
                </span>
              </figcaption>
            </figure>
          ))}
        </div>
        {additionalTestimonials.length > 0 && (
          <details class="quotes-more">
            <summary>Read {additionalTestimonials.length} more colleague recommendations</summary>
            <div class="quotes quotes--more" role="list">
              {additionalTestimonials.map((t) => (
                <figure class="quote" role="listitem">
                  <i class="fas fa-quote-left quote__mark" aria-hidden="true"></i>
                  <blockquote>{t.quote}</blockquote>
                  <figcaption>
                    <span class="quote__avatar" aria-hidden="true">{initials(t.name)}</span>
                    <span>
                      <strong>{t.name}</strong>
                      <span class="quote__role">{t.role}{t.org ? `, ${t.org}` : ''}</span>
                    </span>
                  </figcaption>
                </figure>
              ))}
            </div>
          </details>
        )}
      </>
    )}
  </div>
</section>

<style>
  /* ---------- Logos ---------- */
  .logo-group {
    max-width: 900px;
    margin: 0 auto 1.75rem;
  }

  .logo-grid--featured {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .logo-grid--additional {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
    margin: 0;
  }

  .logo-grid--additional > li {
    flex: 0 0 7rem;
  }

  /* Every tile is the same size and shape; the dark variant exists only for
     white logos that would disappear on a light tile. */
  .logo-tile {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 9.5rem;
    height: 4.5rem;
    padding: 0.8rem 1rem;
    border-radius: 0.75rem;
    background: #fff;
    border: 1px solid var(--color-border, rgba(0, 0, 0, 0.08));
  }

  .logo-tile--dark {
    background: #212529;
    border-color: rgba(255, 255, 255, 0.1);
  }

  .logo-tile--featured {
    width: 100%;
    height: 5.5rem;
    padding: 1rem 1.5rem;
  }

  .logo-tile--additional {
    width: 100%;
    height: 3.5rem;
    padding: 0.45rem 0.75rem;
  }

  /* Muted by default so the row reads as one set; full colour on hover. */
  .logo-tile img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    filter: grayscale(1);
    opacity: 0.7;
    transition: filter 0.2s ease, opacity 0.2s ease;
  }

  .logo-tile:hover img,
  .logo-tile:focus-visible img {
    filter: none;
    opacity: 1;
  }

  .logo-tile:focus-visible {
    outline: 2px solid var(--color-accent, #4d9aff);
    outline-offset: 3px;
  }

  /* ---------- Testimonials ---------- */
  .quotes {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .quote {
    margin: 0;
    padding: 1.5rem;
    border-radius: 1rem;
    border: 1px solid var(--color-border, rgba(0, 0, 0, 0.08));
    background: var(--color-surface, transparent);
  }

  .quote__mark {
    color: var(--color-accent, #0d6efd);
    opacity: 0.5;
    font-size: 1.1rem;
    margin-bottom: 0.6rem;
  }

  .quote blockquote {
    font-size: 0.98rem;
    line-height: 1.65;
    color: var(--color-text-secondary);
    margin-bottom: 1rem;
  }

  .quote figcaption {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.85rem;
  }

  .quote figcaption strong {
    display: block;
    color: var(--color-heading);
  }

  .quote__role {
    color: var(--color-text-secondary);
  }

  .quote__avatar {
    flex: 0 0 auto;
    display: grid;
    place-items: center;
    width: 2.4rem;
    height: 2.4rem;
    border-radius: 50%;
    font-weight: 700;
    font-size: 0.8rem;
    color: #fff;
    background: var(--color-accent, #0d6efd);
  }

  .quotes-more {
    margin-top: 1.25rem;
  }

  .quotes-more summary {
    display: inline-block;
    color: var(--color-accent, #0d6efd);
    cursor: pointer;
    font-weight: 600;
    padding: 0.35rem 0;
  }

  .quotes-more[open] .quotes {
    margin-top: 1rem;
  }

  /* Keep logo tiers readable and the quote order predictable on phones. */
  @media (max-width: 767.98px) {
    .logo-grid--featured {
      gap: 0.5rem;
    }

    .logo-tile--featured {
      height: 4.25rem;
      padding: 0.5rem;
    }

    .logo-tile--additional {
      width: 100%;
      height: 3rem;
      padding: 0.35rem 0.5rem;
    }

    .logo-grid--additional > li {
      flex-basis: 5.75rem;
    }

    .quotes {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .logo-tile img {
      transition: none;
    }
  }
</style>
