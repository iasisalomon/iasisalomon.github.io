---
import { getCaseStudiesIn, getRepos } from '../data/queries';
import RepoRow from './RepoRow.astro';
import { useTranslations, type Locale } from '../i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

// Rendered inside the Work screen as a compact list under the case studies.
// Repos keep their real status so nothing reads as client work.
const repos = await getRepos(lang);
// Featured repos are listed up front; the rest go in the collapsible archive.
const featuredRepos = repos.filter((repo) => repo.featured);
const additionalRepos = repos.filter((repo) => !repo.featured);

// Repos with a written case study link their title to it.
const caseStudySlugs = new Set((await getCaseStudiesIn(lang)).map((cs) => cs.slug));
---

{/* Keeps its own anchor so case-study "back" links land here. */}
<div id="engineering" class="engineering">
  <div class="engineering__head">
    <h3 class="engineering__title">{t('engineering.title')}</h3>
    <p class="engineering__subtitle mb-0">{t('engineering.subtitle')}</p>
  </div>

  <ul class="repo-list list-unstyled mb-0">
    {featuredRepos.map((repo) => <RepoRow repo={repo} hasCaseStudy={caseStudySlugs.has(repo.slug)} lang={lang} />)}
  </ul>

  {additionalRepos.length > 0 && (
    <details class="repo-archive">
      <summary>{t('engineering.more', { count: additionalRepos.length })}</summary>
      <ul class="repo-list list-unstyled mb-0">
        {additionalRepos.map((repo) => <RepoRow repo={repo} hasCaseStudy={caseStudySlugs.has(repo.slug)} lang={lang} />)}
      </ul>
    </details>
  )}
</div>

<style>
  .engineering {
    margin-top: 1.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-border);
    scroll-margin-top: 96px;
  }

  .engineering__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 1rem;
    margin-bottom: 0.75rem;
  }

  .engineering__title {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-heading);
    margin: 0;
  }

  .engineering__subtitle {
    font-size: 0.9rem;
    color: var(--color-text-secondary);
  }

  .repo-list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.75rem;
  }

  .repo-archive {
    margin-top: 0.75rem;
  }

  .repo-archive summary {
    display: inline-block;
    color: var(--color-accent, #0d6efd);
    cursor: pointer;
    font-weight: 600;
    padding: 0.35rem 0;
  }

  .repo-archive[open] .repo-list {
    margin-top: 0.5rem;
  }

  @media (max-width: 767.98px) {
    .repo-list {
      grid-template-columns: 1fr;
    }
  }
</style>
