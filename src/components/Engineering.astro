---
import { Icon } from 'astro-icon/components';
import ProjectCard from './ProjectCard.astro';
import { featuredFirst, getRepos } from '../data/queries';
import { localePath, useTranslations, type Locale } from '../i18n';
import { projectCard } from '../utils/projects';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

// Its own screen after Work: the hands-on technical projects that back up
// the delivery work, with enough on each card (what, status, stack, links)
// to count as evidence. Repos keep their real status so nothing reads as
// client work.
// Two full rows of three: featured repos first, then the rest in data
// order; the others are in the /projects/ archive.
const VISIBLE = 6;
const repos = featuredFirst(await getRepos(lang)).slice(0, VISIBLE);
---

<section id="engineering" class="screen bg-light">
  <div class="container">
    <h2 class="text-center mt-1 mb-2">{t('engineering.title')}</h2>
    <p class="text-center text-muted mb-3">{t('engineering.subtitle')}</p>
    <div class="section-divider mb-4"></div>

    <div class="row g-4 justify-content-center swipe-row">
      {repos.map((repo) => (
        <div class="col-md-6 col-lg-4">
          <ProjectCard {...projectCard(repo, lang, { media: false })} />
        </div>
      ))}
    </div>

    <div class="text-center mt-4">
      <a href={`${localePath(lang, '/projects/')}?area=software-engineering`} class="btn btn-outline-dark">{t('engineering.viewAll')} <Icon name="fa6-solid:arrow-right" class="ms-1" aria-hidden="true" /></a>
    </div>
  </div>
</section>
