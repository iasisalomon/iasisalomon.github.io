---
import { featuredFirst, getCaseStudiesIn, getRepos } from '../data/queries';
import RepoCard from './RepoCard.astro';
import { useTranslations, type Locale } from '../i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

// Its own screen after Work: the hands-on technical projects that back up
// the delivery work, with enough on each card (what, status, stack, links)
// to count as evidence. Repos keep their real status so nothing reads as
// client work.
const repos = await getRepos(lang);
// Two full rows of three: featured repos first, then the rest in data
// order; anything past six goes in the collapsible archive.
const VISIBLE = 6;
const ordered = featuredFirst(repos);
const featuredRepos = ordered.slice(0, VISIBLE);
const additionalRepos = ordered.slice(VISIBLE);

// Repos with a written case study link their title to it.
const caseStudyHrefs = new Map((await getCaseStudiesIn(lang)).map((cs) => [cs.slug, cs.href]));
---

<section id="engineering" class="screen bg-light">
  <div class="container">
    <h2 class="text-center mt-1 mb-2">{t('engineering.title')}</h2>
    <p class="text-center text-muted mb-3">{t('engineering.subtitle')}</p>
    <div class="section-divider mb-4"></div>

    <div class="row g-4 justify-content-center swipe-row">
      {featuredRepos.map((repo) => (
        <RepoCard repo={repo} caseStudyHref={caseStudyHrefs.get(repo.slug)} lang={lang} />
      ))}
    </div>

    {additionalRepos.length > 0 && (
      <details class="repo-archive">
        <summary>{t('engineering.more', { count: additionalRepos.length })}</summary>
        <div class="row g-4 mt-1">
          {additionalRepos.map((repo) => (
            <RepoCard repo={repo} caseStudyHref={caseStudyHrefs.get(repo.slug)} lang={lang} />
          ))}
        </div>
      </details>
    )}
  </div>
</section>

<style>
  .repo-archive {
    margin-top: 1.25rem;
    text-align: center;
  }

  .repo-archive summary {
    display: inline-block;
    color: var(--color-accent);
    cursor: pointer;
    font-size: 0.9rem;
    font-weight: 600;
    padding: 0.35rem 0;
  }

  .repo-archive[open] .row {
    text-align: left;
  }
</style>
