---
import { Icon } from 'astro-icon/components';
// One navbar for the whole site: a link per homepage screen (NAV_LINKS in
// consts.ts), so moving between the homepage, the blog and case studies
// never changes the menu under the reader.
//  - On the homepage the links smooth-scroll to their screen.
//  - Elsewhere they navigate to the homepage screen (`/#id`), which the
//    browser opens already in place.
//  - variant 'blog' (archive and posts): the Blog link points to the archive
//    and is marked current. variant 'work' (case studies): the Work link is
//    marked current and still leads back to the Work screen.
// Below 992px, where the links fold into the menu, the bar names the
// current section on the left so the reader always knows where they are.
// Links stay within the page's language; the language switcher opens the
// same page in the other language.
import { NAV_LINKS } from '../consts';
import { localePath, otherLocale, useTranslations, type Alternates, type Locale } from '../i18n';

interface Props {
  lang?: Locale;
  /** The page's address in each language; without one in the other
   *  language, the switcher goes to that language's home (or blog). */
  alternates?: Alternates;
  variant?: 'main' | 'blog' | 'work';
}
const { lang = 'en', alternates = {}, variant = 'main' } = Astro.props;
const t = useTranslations(lang);
const home = localePath(lang, '/');
const blog = localePath(lang, '/blog/');

const links = NAV_LINKS.map((link) => ({
  label: t(link.label),
  href: variant === 'blog' && link.hash === '#blog' ? blog : `${home}${link.hash}`,
  current: (variant === 'blog' && link.hash === '#blog') || (variant === 'work' && link.hash === '#work'),
}));
const currentLabel = links.find((l) => l.current)?.label ?? t('nav.home');

const other = otherLocale(lang);
const tOther = useTranslations(other);
const switchHref = alternates[other] ?? localePath(other, variant === 'blog' ? '/blog/' : '/');
---

<a class="skip-link" href="#main-content">{t('nav.skipToContent')}</a>
<nav
  class="navbar navbar-expand-lg navbar-dark fixed-top"
  id="mainNav"
  aria-label={t('nav.mainLabel')}
>
  <div class="container position-relative">
    <span class="nav-current d-lg-none" id="navCurrent" aria-hidden="true">{currentLabel}</span>
    {/* No brand: the links are centred on screen. The controls live outside
         the collapse so they stay usable without opening the menu; on phones
         they sit on the right, on desktop they're pinned to the right edge
         without pushing the centred links off-centre. */}
    <div class="nav-controls d-flex align-items-center gap-2 ms-auto">
      {/* A link drawn as a switch: EN on the left, ES on the right, the knob
           on the current language. Named in the language it switches to, so
           each reader finds theirs. */}
      <a
        class="switch lang-switch"
        id="langSwitch"
        href={switchHref}
        hreflang={other}
        lang={other}
        data-on={lang === 'es'}
        aria-label={tOther('nav.readInLanguage')}
        title={tOther('nav.readInLanguage')}
      >
        <span class="switch__label switch__label--off" aria-hidden="true">EN</span>
        <span class="switch__track" aria-hidden="true"><span class="switch__knob"></span></span>
        <span class="switch__label switch__label--on" aria-hidden="true">ES</span>
      </a>
      {/* Light on the left, dark on the right; the knob follows data-theme on
           <html>, which MainLayout's pre-paint script sets. */}
      <button
        type="button"
        class="switch theme-switch"
        id="themeToggle"
        role="switch"
        aria-label={t('nav.darkMode')}
        aria-checked="false"
      >
        <Icon name="fa6-solid:sun" class="switch__label switch__label--off" aria-hidden="true" />
        <span class="switch__track" aria-hidden="true"><span class="switch__knob"></span></span>
        <Icon name="fa6-solid:moon" class="switch__label switch__label--on" aria-hidden="true" />
      </button>
      <button
        class="navbar-toggler"
        type="button"
        data-bs-toggle="collapse"
        data-bs-target="#navbarNav"
        aria-controls="navbarNav"
        aria-expanded="false"
        aria-label={t('nav.toggle')}
      >
        <span class="navbar-toggler-icon"></span>
      </button>
    </div>
    <div class="collapse navbar-collapse justify-content-lg-center" id="navbarNav">
      <ul class="navbar-nav main-nav">
        {links.map((link) => (
          <li class="nav-item">
            <a
              class:list={['nav-link', { active: link.current }]}
              href={link.href}
              aria-current={link.current ? 'page' : undefined}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</nav>

<style>
  #mainNav {
    background-color: #1c1f23;
    padding: 0.6rem 0;
    transition: all 0.3s ease;
    z-index: 1030;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
  }

  .main-nav .nav-item {
    margin: 0 0.1rem;
  }

  /* Collapsed bar only: the current section's name. */
  .nav-current {
    color: #fff;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    border-left: 2px solid var(--color-accent-on-dark, #4d9aff);
    padding: 0.1rem 0 0.1rem 0.6rem;
    /* Takes the room the controls leave and truncates rather than pushing
       them onto a second row on narrow phones. */
    flex: 1 1 0;
    min-width: 0;
    margin-right: 0.5rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .nav-controls {
    flex-shrink: 0;
  }

  @media (max-width: 399.98px) {
    .nav-current {
      font-size: 0.72rem;
      letter-spacing: 0.03em;
    }
  }

  /* Too narrow to read a truncated name: the open menu still marks it. */
  @media (max-width: 349.98px) {
    .nav-current {
      visibility: hidden;
    }
  }

  /* Compact enough for one link per section on a single row from 992px. */
  .main-nav .nav-link {
    margin: 0;
    padding: 0.5rem 0.6rem;
    font-weight: 500;
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.85);
    position: relative;
    letter-spacing: 0.2px;
    text-transform: uppercase;
    transition: color 0.3s ease, background-color 0.3s ease;
    border-radius: 4px;
    background-color: transparent;
  }

  /* Animated underline */
  .main-nav .nav-link::after {
    content: '';
    position: absolute;
    bottom: 4px;
    left: 10%;
    width: 80%;
    height: 2px;
    background-color: var(--color-accent-on-dark, #4d9aff);
    transform: scaleX(0);
    transform-origin: center;
    transition: transform 0.3s ease;
  }

  .main-nav .nav-link:hover {
    color: #fff;
    background-color: rgba(255, 255, 255, 0.1);
  }

  .main-nav .nav-link.active {
    color: #fff;
  }

  .main-nav .nav-link.active::after {
    transform: scaleX(1);
  }

  @media (min-width: 992px) {
    .nav-controls {
      position: absolute;
      top: 50%;
      right: calc(var(--bs-gutter-x) * 0.5);
      transform: translateY(-50%);
    }
  }

  /* Switches: a label on each side of a track, the knob on the active side.
     Language: EN (off) / ES (on), from data-on, which is flipped on click so
     the knob slides before the page changes. Theme: light (off) / dark (on),
     from data-theme on <html>. */
  .switch {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.35rem 0.25rem;
    border: none;
    background: none;
    cursor: pointer;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    line-height: 1;
    text-decoration: none;
  }

  .switch__label {
    color: rgba(255, 255, 255, 0.45);
    transition: color 0.2s ease;
  }

  .theme-switch .switch__label {
    font-size: 0.85rem;
  }

  .switch__track {
    position: relative;
    width: 2.25rem;
    height: 1.25rem;
    border-radius: 100px;
    background-color: rgba(255, 255, 255, 0.16);
    transition: background-color 0.2s ease;
  }

  .switch:hover .switch__track {
    background-color: rgba(255, 255, 255, 0.26);
  }

  .switch__knob {
    position: absolute;
    top: 0.15rem;
    left: 0.15rem;
    width: 0.95rem;
    height: 0.95rem;
    border-radius: 50%;
    background-color: var(--color-accent-on-dark, #4d9aff);
    transition: transform 0.2s ease;
  }

  /* Off: left label lit. */
  .lang-switch[data-on='false'] .switch__label--off,
  :global(html:not([data-theme='dark'])) .theme-switch .switch__label--off {
    color: #fff;
  }

  /* On: right label lit, knob on the right. */
  .lang-switch[data-on='true'] .switch__label--on,
  :global([data-theme='dark']) .theme-switch .switch__label--on {
    color: #fff;
  }

  .lang-switch[data-on='true'] .switch__knob,
  :global([data-theme='dark']) .theme-switch .switch__knob {
    transform: translateX(1rem);
  }

  .switch:focus-visible {
    outline: 2px solid var(--color-accent-on-dark, #4d9aff);
    outline-offset: 2px;
    border-radius: 100px;
  }

  @media (prefers-reduced-motion: reduce) {
    .switch__knob,
    .switch__label {
      transition: none;
    }
  }

  .navbar-toggler {
    border: none;
    background-color: rgba(255, 255, 255, 0.08);
    padding: 0.4rem 0.6rem;
    font-size: 0.9rem;
    transition: all 0.2s ease;
  }

  .navbar-toggler:hover {
    background-color: rgba(255, 255, 255, 0.15);
  }

  .navbar-toggler:focus {
    box-shadow: none;
  }

  @media (max-width: 991.98px) {
    #mainNav {
      padding: 0.5rem 0;
    }

    /* The navbar has a fixed height, so the expanded menu overflows past
       the navbar's painted background — give the collapse its own solid
       panel or the links float transparently over page content. */
    .navbar-collapse {
      background-color: #1c1f23;
      border-radius: 0 0 10px 10px;
      box-shadow: 0 10px 20px rgba(0, 0, 0, 0.3);
      margin-top: 0.5rem;
      padding: 0.5rem 1rem 0.75rem;
    }

    .navbar-nav {
      padding: 0.5rem 0;
      text-align: center;
      width: 100%;
    }

    .main-nav .nav-item {
      margin: 0;
      width: 100%;
    }

    .main-nav .nav-link {
      padding: 0.6rem 1rem;
      font-size: 0.95rem;
      display: block;
    }

    /* Underline replaced by a subtle background highlight on mobile */
    .main-nav .nav-link::after {
      display: none;
    }

    .main-nav .nav-link.active {
      background-color: rgba(255, 255, 255, 0.15);
    }
  }
</style>

<script>
  // Importing the plugin also wires up the data-bs-toggle="collapse" toggler.
  import Collapse from 'bootstrap/js/dist/collapse';

  // Theme toggle: flips data-theme on <html> and persists the choice.
  // The pre-paint script in MainLayout reads the same localStorage key.
  const themeButton = document.getElementById('themeToggle');
  const syncThemeButton = () => {
    const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
    themeButton?.setAttribute('aria-checked', String(isDark));
  };
  syncThemeButton();

  // Homepage in any language: /, /es/.
  const HOME_PATH = /^\/(es\/?)?$/;

  // The language switcher keeps the reader on the same homepage section, or
  // the same category of the blog archive.
  const langSwitch = document.getElementById('langSwitch') as HTMLAnchorElement | null;
  const startOn = langSwitch?.dataset.on;
  langSwitch?.addEventListener('click', (e) => {
    const target = new URL(langSwitch.href);
    if (HOME_PATH.test(target.pathname)) target.hash = window.location.hash;
    if (/^\/(es\/)?blog\/$/.test(target.pathname)) target.search = window.location.search;
    langSwitch.href = target.href;

    // Opening in a new tab or window: leave it to the browser.
    if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || e.button !== 0) return;
    // Slide the knob first, then go.
    e.preventDefault();
    langSwitch.dataset.on = String(startOn !== 'true');
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    setTimeout(() => window.location.assign(target.href), reduced ? 0 : 200);
  });
  // Coming back through the back/forward cache: put the knob back.
  window.addEventListener('pageshow', (e) => {
    if (e.persisted && langSwitch && startOn) langSwitch.dataset.on = startOn;
  });

  themeButton?.addEventListener('click', () => {
    const root = document.documentElement;
    const next = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
    if (next === 'dark') {
      root.setAttribute('data-theme', 'dark');
    } else {
      root.removeAttribute('data-theme');
    }
    try {
      localStorage.setItem('theme', next);
    } catch {}
    syncThemeButton();
  });

  document.addEventListener('DOMContentLoaded', function () {
    const collapse = document.getElementById('navbarNav');
    const isHome = HOME_PATH.test(window.location.pathname) || window.location.pathname === '';

    const anchorLinks = Array.from(
      document.querySelectorAll('#navbarNav .nav-link')
    ).filter((l) => (l.getAttribute('href') || '').includes('#'));

    function hashOf(link) {
      const href = link.getAttribute('href') || '';
      const i = href.indexOf('#');
      return i >= 0 ? href.slice(i) : null; // e.g. '#about'
    }

    // While a click-initiated smooth scroll is in flight the scroll-spy
    // leaves the marker on the clicked target instead of re-marking every
    // screen passing by. Cleared once scrolling settles (scrollend, with a
    // timer for browsers without it) or the reader takes over.
    let lockedHash = null;
    let lockTimer = null;

    function unlock() {
      if (!lockedHash) return;
      lockedHash = null;
      clearTimeout(lockTimer);
      markCurrent();
    }

    const screens = Array.from(document.querySelectorAll('main > section[id]'));
    const SPY_LINE = 0.4; // fraction of the viewport height

    // The screen under the spy line, for when the observer can't say (after
    // a locked scroll, on arrival).
    function markCurrent() {
      const y = window.innerHeight * SPY_LINE;
      const current = screens.find((sec) => {
        const r = sec.getBoundingClientRect();
        return r.top <= y && r.bottom > y;
      });
      if (current) setActive('#' + current.id);
    }
    // A scrollend left over from an earlier scroll can fire after the click,
    // so only release once the target has actually arrived.
    window.addEventListener('scrollend', () => {
      const target = lockedHash && document.querySelector(lockedHash);
      if (!target) return;
      const margin = parseFloat(getComputedStyle(target).scrollMarginTop) || 0;
      if (Math.abs(target.getBoundingClientRect().top - margin) < 8) unlock();
    });
    ['wheel', 'touchstart', 'keydown'].forEach((type) =>
      window.addEventListener(type, unlock, { passive: true })
    );

    function scrollToSection(hash) {
      const section = document.querySelector(hash);
      if (!section) return false;
      lockedHash = hash;
      clearTimeout(lockTimer);
      lockTimer = setTimeout(unlock, 2000);
      // The target's scroll-margin-top keeps it flush under the navbar, the
      // same spot a native hash jump or a snap lands on.
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      section.scrollIntoView({ behavior: reduced ? 'instant' : 'smooth', block: 'start' });
      return true;
    }

    const navCurrent = document.getElementById('navCurrent');

    function setActive(hash) {
      anchorLinks.forEach((l) => {
        const active = hashOf(l) === hash;
        l.classList.toggle('active', active);
        if (active) l.setAttribute('aria-current', 'location');
        else l.removeAttribute('aria-current');
        if (active && navCurrent) navCurrent.textContent = l.textContent?.trim() ?? '';
      });
    }

    if (!isHome) return; // On other pages the links are plain navigation.
    setActive(window.location.hash || '#home');

    // Smooth-scroll for in-page section links.
    anchorLinks.forEach((link) => {
      link.addEventListener('click', function (e) {
        const hash = hashOf(link);
        if (!hash || !document.querySelector(hash)) return; // let it navigate
        e.preventDefault();
        if (window.location.hash !== hash) {
          history.pushState(null, '', `${window.location.pathname}${window.location.search}${hash}`);
        }
        setActive(hash);
        scrollToSection(hash);
        // Close the mobile menu via Bootstrap's API rather than simulating a
        // toggler click — a synthetic click fired mid-transition desyncs
        // Bootstrap's internal state and breaks the next tap on touch devices.
        if (collapse.classList.contains('show')) {
          Collapse.getOrCreateInstance(collapse).hide();
        }
      });
    });

    // Scroll-spy: the screen crossing a thin line 40% down the viewport is
    // the one in view. Exactly one screen crosses it at any time, so the
    // marker moves once per screen with no timers or position maths.
    const spy = new IntersectionObserver(
      (entries) => {
        if (lockedHash) return;
        entries.forEach((entry) => {
          if (entry.isIntersecting) setActive('#' + entry.target.id);
        });
      },
      { rootMargin: `-${SPY_LINE * 100}% 0px -${99 - SPY_LINE * 100}% 0px` }
    );
    screens.forEach((sec) => spy.observe(sec));

    window.addEventListener('popstate', function () {
      const hash = window.location.hash || '#home';
      setActive(hash);
      if (hash === '#home' && !window.location.hash) window.scrollTo({ top: 0, behavior: 'instant' });
      else scrollToSection(hash);
    });

    // Arriving with a hash (e.g. from the blog): open on that screen
    // directly, like turning to a page, rather than showing the hero and
    // then scrolling down. The browser's own hash jump usually does this
    // already; this re-aligns it once in case layout shifted, and marks the
    // screen that holds the target (it may be a block inside one).
    if (window.location.hash) {
      const target = document.querySelector(window.location.hash);
      const screen = target?.closest('main > section[id]');
      target?.scrollIntoView({ behavior: 'instant', block: 'start' });
      if (screen) setActive('#' + screen.id);
    }
  });
</script>
