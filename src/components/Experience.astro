---
import { formatRange, getFeaturedExperience, type Role } from '../data/queries';
import { useTranslations, type Locale } from '../i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

// Roles live in src/data/experience.json. Consecutive roles at the same
// organization are grouped under it, with each role's own dates.
interface Job {
  title?: string;
  company: string;
  dates: string;
  bullets?: string[];
  roles?: { title: string; dates: string; bullets: string[] }[];
}

const groups: Role[][] = [];
for (const role of await getFeaturedExperience(lang)) {
  const last = groups.at(-1);
  if (last && last[0].organization === role.organization) last.push(role);
  else groups.push([role]);
}

const company = (r: Role) => (r.organizationNote ? `${r.organization} (${r.organizationNote})` : r.organization);

// Roles are newest first, so a group spans from its last role's start to its first role's end.
const jobs: Job[] = groups.map((roles) =>
  roles.length === 1
    ? { title: roles[0].title, company: company(roles[0]), dates: formatRange(roles[0].start, roles[0].end, lang), bullets: roles[0].bullets }
    : {
        company: company(roles[0]),
        dates: formatRange(roles.at(-1)!.start, roles[0].end, lang),
        roles: roles.map((r) => ({ title: r.title, dates: formatRange(r.start, r.end, lang), bullets: r.bullets })),
      },
);
---

<section id="experience" class="py-6 bg-light">
  <div class="container">
    <h2 class="text-center mt-1 mb-4">{t('experience.title')}</h2>
    <div class="section-divider mb-5"></div>
    <div class="row justify-content-center">
      <div class="col-lg-8">
        {jobs.map((job) => (
          <article class="job">
            <div class="job-head">
              <h3 class="h5 mb-1">
                {job.title ? <>{job.title}, <span class="company">{job.company}</span></> : job.company}
              </h3>
              <span class="dates">{job.dates}</span>
            </div>
            {job.bullets && (
              <ul>
                {job.bullets.map((b) => <li>{b}</li>)}
              </ul>
            )}
            {job.roles?.map((role) => (
              <div class="sub-role">
                <h4 class="h6 mb-1">
                  {role.title} <span class="dates">({role.dates})</span>
                </h4>
                <ul>
                  {role.bullets.map((b) => <li>{b}</li>)}
                </ul>
              </div>
            ))}
          </article>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .job {
    padding-bottom: 1.5rem;
    margin-bottom: 1.5rem;
    border-bottom: 1px solid var(--color-border, rgba(0, 0, 0, 0.08));
  }

  .job:last-child {
    border-bottom: none;
  }

  .job-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.25rem 1rem;
    margin-bottom: 0.5rem;
  }

  .company {
    font-weight: 400;
  }

  .dates {
    color: var(--color-text-secondary);
    font-size: 0.9rem;
    font-weight: 400;
  }

  .sub-role {
    margin-top: 0.75rem;
  }

  ul {
    color: var(--color-text-secondary);
    line-height: 1.7;
    padding-left: 1.2rem;
    margin-bottom: 0;
  }
</style>
