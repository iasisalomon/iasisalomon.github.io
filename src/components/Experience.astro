---
import { formatRange, getFeaturedExperience, type Role } from '../data/queries';
import { useTranslations, type Locale } from '../i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

// Roles live in src/data/experience.json. Consecutive roles at the same
// organization are grouped under it, with each role's own dates.
interface Job {
  title?: string;
  company: string;
  dates: string;
  bullets?: string[];
  roles?: { title: string; dates: string; bullets: string[] }[];
}

const groups: Role[][] = [];
for (const role of await getFeaturedExperience(lang)) {
  const last = groups.at(-1);
  if (last && last[0].organization === role.organization) last.push(role);
  else groups.push([role]);
}

const company = (r: Role) => (r.organizationNote ? `${r.organization} (${r.organizationNote})` : r.organization);

// Roles are newest first, so a group spans from its last role's start to its first role's end.
const jobs: Job[] = groups.map((roles) =>
  roles.length === 1
    ? { title: roles[0].title, company: company(roles[0]), dates: formatRange(roles[0].start, roles[0].end, lang), bullets: roles[0].bullets }
    : {
        company: company(roles[0]),
        dates: formatRange(roles.at(-1)!.start, roles[0].end, lang),
        roles: roles.map((r) => ({ title: r.title, dates: formatRange(r.start, r.end, lang), bullets: r.bullets })),
      },
);
---

{/* One screen: every role is a row; the three newest are open and the rest expand
     on demand, so the whole history fits without a long scroll. */}
<section id="experience" class="screen bg-light">
  <div class="container">
    <h2 class="text-center mt-1 mb-3">{t('experience.title')}</h2>
    <div class="section-divider mb-4"></div>
    <div class="row justify-content-center">
      <div class="col-lg-8">
        {jobs.map((job, i) => (
          <details class="job" open={i < 3}>
            <summary class="job-head">
              <h3 class="h6 mb-0">
                {job.title ? <>{job.title}, <span class="company">{job.company}</span></> : job.company}
              </h3>
              <span class="dates">{job.dates}</span>
            </summary>
            <div class="job-body">
              {job.bullets && (
                <ul>
                  {job.bullets.map((b) => <li>{b}</li>)}
                </ul>
              )}
              {job.roles?.map((role) => (
                <div class="sub-role">
                  <h4 class="h6 mb-1">
                    {role.title} <span class="dates">({role.dates})</span>
                  </h4>
                  <ul>
                    {role.bullets.map((b) => <li>{b}</li>)}
                  </ul>
                </div>
              ))}
            </div>
          </details>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .job {
    border-bottom: 1px solid var(--color-border, rgba(0, 0, 0, 0.08));
  }

  .job:last-child {
    border-bottom: none;
  }

  .job-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.25rem 1rem;
    padding: 0.9rem 0 0.9rem 1.5rem;
    position: relative;
    cursor: pointer;
    list-style: none;
  }

  .job-head::-webkit-details-marker {
    display: none;
  }

  /* Chevron: points right when closed, down when open. */
  .job-head::before {
    content: '';
    position: absolute;
    left: 0.2rem;
    top: 1.3rem;
    width: 0.45rem;
    height: 0.45rem;
    border-right: 2px solid var(--color-text-secondary);
    border-bottom: 2px solid var(--color-text-secondary);
    transform: rotate(-45deg);
    transition: transform 0.2s ease;
  }

  .job[open] > .job-head::before {
    transform: rotate(45deg);
  }

  .job-head:hover h3 {
    color: var(--color-accent);
  }

  .job-head h3 {
    font-size: 1rem;
    transition: color 0.2s ease;
  }

  .job-body {
    padding: 0 0 1.1rem 1.5rem;
  }

  .company {
    font-weight: 400;
  }

  .dates {
    color: var(--color-text-secondary);
    font-size: 0.9rem;
    font-weight: 400;
  }

  .sub-role {
    margin-top: 0.75rem;
  }

  ul {
    color: var(--color-text-secondary);
    line-height: 1.7;
    padding-left: 1.2rem;
    margin-bottom: 0;
  }
</style>
