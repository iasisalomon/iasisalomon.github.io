---
import { FACTS } from '../consts';

// Titles, employers and dates must match the CV and LinkedIn exactly.
interface Role {
  title: string;
  dates?: string;
  bullets: string[];
}
interface Job {
  title?: string;
  company: string;
  dates: string;
  bullets?: string[];
  roles?: Role[];
}

const jobs: Job[] = [
  {
    title: 'Head of Operations',
    company: 'HomeTeam Network (Hybrid, Rosario, Argentina)',
    dates: 'Jan 2026 – Present',
    bullets: [
      `Run all operations except payments and finance, building and leading the team from zero to ${FACTS.teamSize} contractors and owning hiring, onboarding, scheduling and performance management end to end.`,
      'Launched the remote production operation in 6 weeks, setting up the equipment, network and operating procedures.',
      `Owned broadcast scheduling and resource allocation for ${FACTS.broadcastsInOneMonth} live baseball broadcasts in a single month across 9 North American leagues, assigning 57 operators over ${FACTS.crewHoursInOneMonth} crew hours, with peaks of 23 games in a day.`,
    ],
  },
  {
    title: 'Automation Engineer',
    company: 'Interlaced LLC (contract)',
    dates: 'Apr 2025 – Dec 2025',
    bullets: [
      'Owned the design, delivery and maintenance of operational workflows end to end, using Rewst, n8n, Retool and Make.',
      `Automated client onboarding end to end, eliminating an estimated ${FACTS.onboardingMinutesSaved} minutes of manual work per onboarding: each support ticket provisions the user in Google Workspace, notifies support and the client, and retries failures automatically before escalating to a person.`,
    ],
  },
  {
    title: 'Software Engineer',
    company: 'Pythas LLC (contract)',
    dates: 'Jan 2025 – Nov 2025',
    bullets: [
      'Owned scope, timeline and technical delivery of a fintech proof of concept: virtual bank accounts with USD/USDC swaps, built on the Rail API.',
      'Validated the product idea with a working proof of concept, which the founders used to decide how to build the full product.',
    ],
  },
  {
    company: 'Sky Mavis (creator of Axie Infinity)',
    dates: 'Oct 2021 – Nov 2024',
    roles: [
      {
        title: 'Operations Project Manager',
        dates: 'May 2023 – Nov 2024',
        bullets: [
          'Coordinated a 4-person team within an 8-person operations group.',
          'Automated Jira intake and handoffs across Legal, Growth, Operations and Finance, so cross-team requests were routed and tracked without manual follow-up.',
          'Owned the rollout of the company-wide security training program, sustaining a 95% monthly completion rate across distributed teams.',
          'Wrote SOPs and self-service guides for recurring requests.',
        ],
      },
      {
        title: 'Project Manager, Esports',
        dates: 'Jun 2022 – May 2023',
        bullets: [
          'Managed LATAM operations for the Esports department, coordinating event production and broadcast for Axie Infinity esports.',
        ],
      },
      {
        title: 'Support Specialist',
        dates: 'Oct 2021 – Jun 2022',
        bullets: ['Built Node.js REST endpoints to integrate CovalentHQ and internal data sources.'],
      },
    ],
  },
  {
    title: 'Quality Assurance Engineer',
    company: 'Scale Services Corp (contract)',
    dates: 'Jan 2021 – Nov 2021',
    bullets: [
      'API and unit testing in Node.js and Mocha, domain-driven test definitions and OpenAPI documentation.',
    ],
  },
];
---

<section id="experience" class="py-6 bg-light">
  <div class="container">
    <h2 class="text-center mt-1 mb-4">Experience</h2>
    <div class="section-divider mb-5"></div>
    <div class="row justify-content-center">
      <div class="col-lg-8">
        {jobs.map((job) => (
          <article class="job">
            <div class="job-head">
              <h3 class="h5 mb-1">
                {job.title ? <>{job.title}, <span class="company">{job.company}</span></> : job.company}
              </h3>
              <span class="dates">{job.dates}</span>
            </div>
            {job.bullets && (
              <ul>
                {job.bullets.map((b) => <li>{b}</li>)}
              </ul>
            )}
            {job.roles?.map((role) => (
              <div class="sub-role">
                <h4 class="h6 mb-1">
                  {role.title} <span class="dates">({role.dates})</span>
                </h4>
                <ul>
                  {role.bullets.map((b) => <li>{b}</li>)}
                </ul>
              </div>
            ))}
          </article>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .job {
    padding-bottom: 1.5rem;
    margin-bottom: 1.5rem;
    border-bottom: 1px solid var(--color-border, rgba(0, 0, 0, 0.08));
  }

  .job:last-child {
    border-bottom: none;
  }

  .job-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.25rem 1rem;
    margin-bottom: 0.5rem;
  }

  .company {
    font-weight: 400;
  }

  .dates {
    color: var(--color-text-secondary);
    font-size: 0.9rem;
    font-weight: 400;
  }

  .sub-role {
    margin-top: 0.75rem;
  }

  ul {
    color: var(--color-text-secondary);
    line-height: 1.7;
    padding-left: 1.2rem;
    margin-bottom: 0;
  }
</style>
