---
import { Icon } from 'astro-icon/components';
import type { Project } from '../data/queries';
import { localePath, useTranslations, type Locale, type TranslationKey } from '../i18n';

// One engineering project on the Engineering screen: what it is, its honest
// status, what it's built with, and where to see it. Same card language as
// the Work cards (bordered, no shadow).
interface Props {
  repo: Project;
  hasCaseStudy: boolean;
  lang: Locale;
}

const { repo, hasCaseStudy, lang } = Astro.props;
const t = useTranslations(lang);

const STATUS_LABELS: Record<NonNullable<Project['status']>, TranslationKey> = {
  practice: 'status.practice',
  challenge: 'status.challenge',
  'private deployment': 'status.privateDeployment',
};
---

<div class="col-md-6 col-lg-4">
  <article class="repo-card h-100 rounded-4 d-flex flex-column">
    <div class="repo-card__head">
      <h3 class="repo-card__title">
        {hasCaseStudy ? (
          <a href={localePath(lang, `/projects/${repo.slug}/`)}>
            {repo.title}
            <Icon name="fa6-solid:arrow-right" class="ms-1" aria-hidden="true" />
          </a>
        ) : (
          repo.title
        )}
      </h3>
      {repo.status && <span class="repo-card__status">{t(STATUS_LABELS[repo.status])}</span>}
    </div>
    <p class="repo-card__text">{repo.description}</p>
    <p class="repo-card__stack">{repo.skills.join(' · ')}</p>
    {repo.links.length > 0 && (
      <div class="repo-card__links">
        {repo.links.map((link) => (
          <a href={link.url} target="_blank" rel="noopener noreferrer">
            <Icon name={link.icon} class="me-1" aria-hidden="true" />{link.text}
          </a>
        ))}
      </div>
    )}
  </article>
</div>

<style>
  .repo-card {
    padding: 1.25rem 1.4rem;
    border: 1px solid var(--color-border);
    background: var(--color-card);
    transition: border-color 0.2s ease;
  }

  .repo-card:hover {
    border-color: var(--color-border-strong);
  }

  .repo-card__head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 0.75rem;
    margin-bottom: 0.6rem;
  }

  .repo-card__title {
    font-size: 1.02rem;
    margin: 0;
    color: var(--color-heading);
  }

  .repo-card__title a {
    color: inherit;
  }

  .repo-card__title a:hover {
    color: var(--color-accent);
  }

  .repo-card__title :global(svg) {
    font-size: 0.75em;
    color: var(--color-accent);
  }

  .repo-card__status {
    flex: 0 0 auto;
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    padding: 0.2em 0.65em;
    border-radius: var(--radius-pill);
    background: var(--color-hover-bg-strong);
    color: var(--color-heading);
    white-space: nowrap;
  }

  /* Three lines here; the case study or repo has the rest. */
  .repo-card__text {
    flex-grow: 1;
    font-size: 0.88rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
    margin-bottom: 0.6rem;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .repo-card__stack {
    font-size: 0.78rem;
    color: var(--color-text-muted);
    margin-bottom: 0.75rem;
  }

  .repo-card__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.1rem;
    font-size: 0.85rem;
    font-weight: 600;
  }

  .repo-card__links a {
    color: var(--color-accent);
  }
</style>
