---
import { BLOG_CATEGORIES, FOOTER_LINKS, LINKS } from '../consts';

const currentYear = new Date().getFullYear();
---

<footer class="bg-dark text-white">
  <div class="container">
    <div class="footer-navigation py-3">
      <nav aria-label="Blog categories">
        <h3 class="h6 fw-semibold mb-3 text-white-75">Blog</h3>
        <ul class="list-unstyled footer-nav d-flex flex-wrap gap-3 mb-0">
          <li><a href="/blog/">All articles</a></li>
          {BLOG_CATEGORIES.map((c) => (
            <li><a href={`/blog/?category=${c.id}`}>{c.label}</a></li>
          ))}
        </ul>
      </nav>

      <nav aria-label="Site map">
        <h3 class="h6 fw-semibold mb-3 text-white-75">Site</h3>
        <ul class="list-unstyled footer-nav d-flex flex-wrap gap-3 mb-0">
          {FOOTER_LINKS.map((link) => (
            <li><a href={link.href}>{link.label}</a></li>
          ))}
        </ul>
      </nav>
    </div>

    <nav class="footer-socials" aria-label="Social profiles">
      <a href={LINKS.linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
        <i class="fab fa-linkedin-in" aria-hidden="true"></i>
      </a>
      <a href={LINKS.github} target="_blank" rel="noopener noreferrer" aria-label="GitHub">
        <i class="fab fa-github" aria-hidden="true"></i>
      </a>
      <a href={LINKS.x} target="_blank" rel="noopener noreferrer" aria-label="X">
        <i class="fab fa-x-twitter" aria-hidden="true"></i>
      </a>
      <a href={LINKS.instagram} target="_blank" rel="noopener noreferrer" aria-label="Instagram">
        <i class="fab fa-instagram" aria-hidden="true"></i>
      </a>
      <a href={LINKS.tiktok} target="_blank" rel="noopener noreferrer" aria-label="TikTok">
        <i class="fab fa-tiktok" aria-hidden="true"></i>
      </a>
      <a href={LINKS.telegram} target="_blank" rel="noopener noreferrer" aria-label="Telegram">
        <i class="fab fa-telegram" aria-hidden="true"></i>
      </a>
    </nav>

    <p class="footer-copyright small text-white-50 text-center my-2">
      &copy; {currentYear} Iasi Salomon. All rights reserved. Built with <a href="https://astro.build" target="_blank" rel="noopener noreferrer" class="text-white-50">Astro</a>
    </p>
  </div>
</footer>

<style>
  footer {
    background-color: #1a1d20 !important;
  }

  .text-white-75 {
    color: rgba(255,255,255,0.75);
  }

  .footer-navigation {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .footer-socials {
    display: flex;
    justify-content: center;
    gap: 1.25rem;
    padding: 0.25rem 0 0.75rem;
  }

  .footer-socials a {
    color: rgba(255,255,255,0.55);
    font-size: 1.15rem;
    line-height: 1;
    transition: color 0.2s ease, transform 0.2s ease;
  }

  .footer-socials a:hover {
    color: #fff;
    transform: translateY(-2px);
  }

  .footer-nav li {
    margin-bottom: 0.5rem;
  }

  .footer-nav a {
    color: rgba(255,255,255,0.5);
    font-size: 0.9rem;
    transition: color 0.2s ease;
  }

  .footer-nav a:hover {
    color: #fff;
  }

  .footer-copyright a {
    text-decoration: none;
  }

  .footer-copyright a:hover {
    color: #fff !important;
    text-decoration: underline;
  }

</style>
