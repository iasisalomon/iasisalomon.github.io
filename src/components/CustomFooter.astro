---
import { Icon } from 'astro-icon/components';
import { LINKS } from '../consts';
import { localePath, useTranslations, type Locale } from '../i18n';

// A compact sign-off band. Navigation lives in the fixed navbar on every
// page and the blog categories on the archive, so the footer doesn't
// repeat them: just who this is, where else to find them, and the small
// print.

interface Props {
  lang?: Locale;
}

const { lang = 'en' } = Astro.props;
const t = useTranslations(lang);
const rss = localePath(lang, '/rss.xml');

const currentYear = new Date().getFullYear();

const socials = [
  { href: LINKS.linkedin, label: 'LinkedIn', icon: 'fa6-brands:linkedin-in' },
  { href: LINKS.github, label: 'GitHub', icon: 'fa6-brands:github' },
  { href: LINKS.x, label: 'X', icon: 'fa6-brands:x-twitter' },
  { href: LINKS.instagram, label: 'Instagram', icon: 'fa6-brands:instagram' },
  { href: LINKS.tiktok, label: 'TikTok', icon: 'fa6-brands:tiktok' },
  { href: LINKS.telegram, label: 'Telegram', icon: 'fa6-brands:telegram' },
];
---

<footer class="site-footer">
  <div class="container">
    <h2 class="visually-hidden">{t('footer.heading')}</h2>

    <div class="site-footer__top">
      <p class="site-footer__who mb-0">
        <strong>Iasi Salomon</strong>
        <span>{t('author.role')}</span>
      </p>

      <nav class="site-footer__socials" aria-label={t('footer.socials')}>
        {socials.map((s) => (
          <a href={s.href} target="_blank" rel="noopener noreferrer" aria-label={s.label} title={s.label}>
            <Icon name={s.icon} aria-hidden="true" />
          </a>
        ))}
      </nav>
    </div>

    <div class="site-footer__bottom">
      <p class="mb-0">
        &copy; {currentYear} Iasi Salomon. {t('footer.rights')}
        <a href="https://astro.build" target="_blank" rel="noopener noreferrer">Astro</a>
      </p>
      <p class="site-footer__links mb-0">
        <a href={LINKS.email}>{LINKS.emailAddress}</a>
        <a href={rss}><Icon name="fa6-solid:rss" class="me-1" aria-hidden="true" />RSS</a>
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background-color: #1a1d20;
    color: rgba(255, 255, 255, 0.75);
    padding: 1.75rem 0 1.25rem;
    font-size: 0.85rem;
  }

  /* Same 960px content width as the homepage blocks above it (Let's talk,
     References), so the footer's edges line up with them. */
  .site-footer .container {
    max-width: calc(960px + var(--bs-gutter-x, 1.5rem));
  }

  .site-footer__top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .site-footer__who {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .site-footer__who strong {
    color: #fff;
    font-size: 1rem;
  }

  .site-footer__who span {
    color: rgba(255, 255, 255, 0.55);
  }

  .site-footer__socials {
    display: flex;
    gap: 0.5rem;
  }

  .site-footer__socials a {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.06);
    color: rgba(255, 255, 255, 0.65);
    font-size: 1rem;
    transition: color 0.2s ease, background-color 0.2s ease;
  }

  .site-footer__socials a:hover {
    color: #fff;
    background: var(--color-accent-on-dark, #4d9aff);
  }

  .site-footer__bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    padding-top: 1rem;
    color: rgba(255, 255, 255, 0.45);
    font-size: 0.8rem;
  }

  .site-footer__bottom a {
    color: rgba(255, 255, 255, 0.6);
    text-decoration: none;
  }

  .site-footer__bottom a:hover {
    color: #fff;
    text-decoration: underline;
  }

  .site-footer__links {
    display: flex;
    gap: 1.25rem;
  }

  /* Phones: everything stacks, centred. */
  @media (max-width: 575.98px) {
    .site-footer__top,
    .site-footer__bottom {
      flex-direction: column;
      text-align: center;
    }

    .site-footer__who {
      align-items: center;
    }
  }
</style>
