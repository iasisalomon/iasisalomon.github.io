---
import { getProjectBySlug } from '../data/portfolio';

const axiecon = getProjectBySlug('axiecon-barcelona')!;
---

<section id="community" class="py-6 bg-light">
  <div class="container">
    <h2 class="text-center mt-1 mb-2">Community and events</h2>
    <p class="text-center text-muted mb-4">Event production and community work, told as stories rather than roles.</p>
    <div class="section-divider mb-5"></div>
    <div class="row justify-content-center">
      <div class="col-lg-8">
        <a href={`/projects/${axiecon.slug}/`} class="event-card d-flex flex-column flex-md-row rounded-4 overflow-hidden text-reset">
          <img src={axiecon.image} alt={axiecon.title} loading="lazy" />
          <div class="p-4">
            <h3 class="h5 fw-bold mb-2">{axiecon.title}</h3>
            <p class="small text-muted mb-3">{axiecon.description}</p>
            <span class="small fw-medium read-cta">Read the story <i class="fas fa-arrow-right ms-1"></i></span>
          </div>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .event-card {
    text-decoration: none;
    background: var(--color-surface, #fff);
    border: 1px solid var(--color-border, rgba(0, 0, 0, 0.08));
  }

  .event-card img {
    width: 100%;
    max-height: 220px;
    object-fit: cover;
  }

  @media (min-width: 768px) {
    .event-card img {
      width: 220px;
      max-height: none;
    }
  }

  .read-cta {
    color: var(--color-accent, #0d6efd);
  }
</style>
