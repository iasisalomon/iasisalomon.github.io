---
import { getOrganizations } from '../data/queries';
import { useTranslations, type Locale } from '../i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

// One even grid of same-size tiles, featured organizations first.
const brands = await getOrganizations();
const ordered = [...brands.filter((b) => b.featured), ...brands.filter((b) => !b.featured)];
---

{/* Rendered inside the References screen; keeps its own anchor for old links. */}
<div id="organizations" class="organizations">
  <h3 class="visually-hidden">{t('organizations.title')}</h3>
  <ul class="logo-grid list-unstyled">
    {ordered.map((brand) => (
      <li>
        <a
          class:list={['logo-tile', { 'logo-tile--dark': brand.darkTile }]}
          href={brand.url}
          target="_blank"
          rel="noopener noreferrer"
          title={brand.name}
          aria-label={t('organizations.opensInNewTab', { name: brand.name })}
        >
          <img src={brand.logo} alt={t('organizations.logoAlt', { name: brand.name })} loading="lazy" decoding="async" width="160" height="64" />
        </a>
      </li>
    ))}
  </ul>
</div>

<style>
  .logo-grid {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 0.75rem;
    max-width: 960px;
    margin: 0 auto 2.25rem;
  }

  /* Every tile is the same size and shape; the dark variant exists only for
     white logos that would disappear on a light tile. */
  .logo-tile {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 3.75rem;
    padding: 0.6rem 0.9rem;
    border-radius: 0.75rem;
    background: #fff;
    border: 1px solid var(--color-border, rgba(0, 0, 0, 0.08));
  }

  .logo-tile--dark {
    background: #212529;
    border-color: rgba(255, 255, 255, 0.1);
  }

  /* Dark theme: the white tiles are toned down so they don't glare
     against the page; full brightness on hover. */
  :global([data-theme='dark']) .logo-tile:not(.logo-tile--dark) {
    background: #e9ecef;
  }

  /* Muted by default so the grid reads as one set; full colour on hover. */
  .logo-tile img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    filter: grayscale(1);
    opacity: 0.7;
    transition: filter 0.2s ease, opacity 0.2s ease;
  }

  .logo-tile:hover img,
  .logo-tile:focus-visible img {
    filter: none;
    opacity: 1;
  }

  .logo-tile:focus-visible {
    outline: 2px solid var(--color-accent, #4d9aff);
    outline-offset: 3px;
  }

  @media (max-width: 991.98px) {
    .logo-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  @media (max-width: 575.98px) {
    .logo-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 0.5rem;
    }

    .logo-tile {
      height: 3rem;
      padding: 0.4rem 0.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .logo-tile img {
      transition: none;
    }
  }
</style>
