---
import { useTranslations, type Locale } from '../i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="about" class="py-6">
  <div class="container">
    <h2 class="text-center mt-1 mb-4">{t('about.title')}</h2>
    <div class="section-divider mb-5"></div>
    <div class="row justify-content-center">
      <div class="col-lg-8 about-text">
        <p class="lead">{t('about.lead')}</p>
        <p>{t('about.body1')}</p>
        <p class="mb-0">{t('about.body2')}</p>
      </div>
    </div>
  </div>
</section>

<style>
  #about p {
    color: var(--color-text-secondary);
    font-size: 1rem;
    line-height: 1.6;
    margin-bottom: 1rem;
    max-width: 80ch;
    margin-left: auto;
    margin-right: auto;
  }

  #about p:first-of-type {
    font-size: 1.05rem;
    color: var(--color-heading);
    font-weight: 500;
  }

  @media (max-width: 768px) {
    #about p {
      font-size: 0.9rem;
      margin-bottom: 0.75rem;
      padding: 0 1rem;
    }

    #about p:first-of-type {
      font-size: 1rem;
    }
  }
</style>
