---
import { Icon } from 'astro-icon/components';
import Skills from './Skills.astro';
import { FACTS } from '../consts';
import { pick, useTranslations, type Locale } from '../i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

// Read like a resume summary: the problem I solve, how I solve it, and
// where on this page the proof is. The proof items link to their screens.
const proof = [
  { icon: 'fa6-solid:briefcase', href: '#work', text: t('about.proofWork', { minutes: pick(FACTS.onboardingMinutesSaved, lang) }) },
  { icon: 'fa6-solid:code', href: '#engineering', text: t('about.proofEngineering') },
  { icon: 'fa6-solid:quote-left', href: '#proof', text: t('about.proofReferences') },
];
---

<section id="about" class="screen">
  <div class="container">
    <h2 class="text-center mt-1 mb-3">{t('about.title')}</h2>
    <div class="section-divider mb-4"></div>
    <div class="row gy-4 gx-lg-5 align-items-center">
      <div class="col-lg-7">
        <p class="about-lead">{t('about.lead')}</p>
        <p class="about-approach">{t('about.approach')}</p>

        <h3 class="about-proof__label">{t('about.proofLabel')}</h3>
        <ul class="about-proof list-unstyled mb-0">
          {proof.map((p) => (
            <li>
              <a href={p.href} class="about-proof__item">
                <span class="about-proof__icon" aria-hidden="true"><Icon name={p.icon} /></span>
                <span>{p.text}</span>
                <Icon name="fa6-solid:arrow-down" class="about-proof__arrow" aria-hidden="true" />
              </a>
            </li>
          ))}
        </ul>
      </div>
      <div class="col-lg-5">
        <Skills lang={lang} />
      </div>
    </div>
  </div>
</section>

<style>
  .about-lead {
    font-size: clamp(1.15rem, 1.8vw, 1.35rem);
    font-weight: 600;
    line-height: 1.45;
    letter-spacing: -0.01em;
    color: var(--color-heading);
    margin-bottom: 0.75rem;
  }

  .about-approach {
    color: var(--color-text-secondary);
    font-size: 0.95rem;
    line-height: 1.65;
    margin-bottom: 1.1rem;
  }

  .about-proof__label {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
    margin-bottom: 0.6rem;
  }

  .about-proof {
    display: grid;
    gap: 0.25rem;
  }

  /* Each proof line jumps to the screen that holds it. */
  .about-proof__item {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    padding: 0.45rem 0.6rem;
    margin-inline: -0.6rem;
    border-radius: 0.6rem;
    color: var(--color-text);
    font-size: 0.9rem;
    line-height: 1.5;
  }

  .about-proof__item:hover {
    background: var(--color-hover-bg);
    color: var(--color-heading);
  }

  .about-proof__icon {
    flex: 0 0 auto;
    display: grid;
    place-items: center;
    width: 1.9rem;
    height: 1.9rem;
    border-radius: 0.5rem;
    background: rgba(var(--color-accent-rgb), 0.1);
    color: var(--color-accent);
    font-size: 0.8rem;
  }

  .about-proof__item :global(.about-proof__arrow) {
    flex: 0 0 auto;
    margin-left: auto;
    margin-top: 0.3rem;
    font-size: 0.75rem;
    color: var(--color-text-muted);
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  .about-proof__item:hover :global(.about-proof__arrow) {
    opacity: 1;
  }
</style>
