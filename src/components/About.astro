---
import Skills from './Skills.astro';
import { useTranslations, type Locale } from '../i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="about" class="screen">
  <div class="container">
    <h2 class="text-center mt-1 mb-3">{t('about.title')}</h2>
    <div class="section-divider mb-4"></div>
    <div class="row justify-content-center">
      <div class="col-lg-8 about-text">
        <p class="lead">{t('about.lead')}</p>
        <p>{t('about.body1')}</p>
        <p class="mb-0">{t('about.body2')}</p>
        <Skills lang={lang} />
      </div>
    </div>
  </div>
</section>

<style>
  #about p {
    color: var(--color-text-secondary);
    font-size: 1rem;
    line-height: 1.6;
    margin-bottom: 1rem;
  }

  /* One measure for the lead, the body and Skills, so every block shares
     the same left edge. */
  .about-text {
    max-width: 46rem;
  }

  #about .lead {
    font-size: 1.05rem;
    color: var(--color-heading);
    font-weight: 500;
  }

  @media (max-width: 768px) {
    #about p {
      font-size: 0.9rem;
      margin-bottom: 0.75rem;
    }

    #about .lead {
      font-size: 1rem;
    }
  }
</style>
