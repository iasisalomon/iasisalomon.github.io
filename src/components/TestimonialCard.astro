---
import { Icon } from 'astro-icon/components';
import type { Testimonial } from '../data/queries';

// One quote in the References screen (see Testimonials.astro). Quotes and
// roles stay in their original English on every page.
interface Props {
  testimonial: Testimonial;
}

const { quote, name, role, org } = Astro.props.testimonial;

const initials = name
  .split(' ')
  .map((w) => w[0])
  .slice(0, 2)
  .join('');
---

<figure class="quote" role="listitem">
  <Icon name="fa6-solid:quote-left" class="quote__mark" aria-hidden="true" />
  <blockquote lang="en">{quote}</blockquote>
  <figcaption>
    <span class="quote__avatar" aria-hidden="true">{initials}</span>
    <span>
      <strong>{name}</strong>
      <span class="quote__role" lang="en">{role}{org ? `, ${org}` : ''}</span>
    </span>
  </figcaption>
</figure>

<style>
  .quote {
    margin: 0;
    padding: 1.25rem 1.4rem;
    border-radius: 1rem;
    border: 1px solid var(--color-border);
    background: var(--color-card);
  }

  .quote__mark {
    color: var(--color-accent);
    opacity: 0.5;
    font-size: 1.1rem;
    margin-bottom: 0.4rem;
  }

  .quote blockquote {
    font-size: 0.94rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
    margin-bottom: 1rem;
  }

  .quote figcaption {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.85rem;
  }

  .quote figcaption strong {
    display: block;
    color: var(--color-heading);
  }

  .quote__role {
    color: var(--color-text-secondary);
  }

  .quote__avatar {
    flex: 0 0 auto;
    display: grid;
    place-items: center;
    width: 2.4rem;
    height: 2.4rem;
    border-radius: 50%;
    font-weight: 700;
    font-size: 0.8rem;
    color: #fff;
    background: var(--color-accent);
  }
</style>
