---
// Centralized SEO head: canonical URL, robots, Open Graph, Twitter cards,
// and JSON-LD structured data. Rendered once inside <head> by MainLayout.
import { AUTHOR_NAME, DEFAULT_IMAGE, LINKS } from '../consts';
import { LOCALES, localePath, useTranslations, type Alternates, type Locale } from '../i18n';

interface Props {
  title: string;
  description: string;
  /** Page-relative or absolute image used for social previews. */
  image?: string;
  /** Alt text for `image`; the default image has its own. */
  imageAlt?: string;
  /** 'website' for normal pages, 'article' for blog posts / case studies. */
  type?: 'website' | 'article';
  /** schema.org type for articles: BlogPosting for posts, Article for case studies. */
  schemaType?: 'BlogPosting' | 'Article';
  /** ISO date — only used when type === 'article'. */
  publishedTime?: string;
  /** ISO date — only used when type === 'article'. */
  modifiedTime?: string;
  /** Set true to keep a page out of the index (e.g. thin/utility pages). */
  noindex?: boolean;
  /** Language of the page. */
  lang: Locale;
  /** The page's address in each language it exists in (hreflang alternates). */
  alternates?: Alternates;
}

// Open Graph locale per page language.
const OG_LOCALES: Record<Locale, string> = {
  en: 'en_US',
  es: 'es_AR',
};

const {
  title,
  description,
  image = DEFAULT_IMAGE,
  imageAlt,
  type = 'website',
  schemaType = 'BlogPosting',
  publishedTime,
  modifiedTime,
  noindex = false,
  lang,
  alternates = {},
} = Astro.props;

const t = useTranslations(lang);
// The default card (1200x630) has its own description; a page's own image
// has one only if the page gave it.
const isDefaultImage = image === DEFAULT_IMAGE;
const socialImageAlt = isDefaultImage ? t('site.ogImageAlt') : imageAlt;
const ogLocale = OG_LOCALES[lang];

// `site` is set in astro.config.mjs.
const site = Astro.site!;
const canonicalURL = new URL(Astro.url.pathname, site);
const imageURL = new URL(image, site);

// hreflang only makes sense between two or more versions of a page; English
// is the version for everyone else (x-default).
const languageVersions = LOCALES.flatMap((l) => (alternates[l] ? [{ lang: l, href: new URL(alternates[l]!, site).href }] : []));
const hasTranslations = languageVersions.length > 1;
const xDefault = alternates.en && new URL(alternates.en, site).href;

// Social profiles that establish the author as one entity across the web.
const sameAs = [
  LINKS.github,
  LINKS.linkedin,
  LINKS.x,
  LINKS.instagram,
  LINKS.tiktok,
  LINKS.telegram,
];

const person = {
  '@type': 'Person',
  '@id': `${site.origin}/#person`,
  name: AUTHOR_NAME,
  url: site.origin,
  image: new URL('/images/cara.jpg', site).href,
  jobTitle: 'Technical Delivery Manager',
  description: t('site.personDescription'),
  knowsAbout: [
    'Technical Delivery Management',
    'Delivery Operations',
    'Automation',
    'AI',
    'Agile and Scrum',
    'Software Engineering',
  ],
  sameAs,
};

const website = {
  '@type': 'WebSite',
  '@id': `${site.origin}/#website`,
  url: site.origin,
  name: t('site.title'),
  description: t('site.description'),
  publisher: { '@id': `${site.origin}/#person` },
  inLanguage: [...LOCALES],
};

// Build the @graph: Person + WebSite are sitewide; BlogPosting/Article only on articles.
const graph: Record<string, unknown>[] = [person, website];

if (type === 'article') {
  graph.push({
    '@type': schemaType,
    '@id': `${canonicalURL.href}#article`,
    headline: title,
    description,
    image: imageURL.href,
    url: canonicalURL.href,
    ...(publishedTime && { datePublished: publishedTime }),
    ...(modifiedTime && { dateModified: modifiedTime }),
    author: { '@id': `${site.origin}/#person` },
    publisher: { '@id': `${site.origin}/#person` },
    mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalURL.href },
    inLanguage: lang,
  });
}

const jsonLd = { '@context': 'https://schema.org', '@graph': graph };
---

{/* Google Search Console (backup verification method) */}
<meta name="google-site-verification" content="ulpwBKmYUACv90pdQhRC_Ha5ykZH13GYTWWvv7q1v6U" />

{/* Canonical & robots */}
<link rel="canonical" href={canonicalURL} />
<meta
  name="robots"
  content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large, max-snippet:-1'}
/>
<meta name="author" content={AUTHOR_NAME} />

{/* The same page in other languages */}
{hasTranslations && languageVersions.map((v) => <link rel="alternate" hreflang={v.lang} href={v.href} />)}
{hasTranslations && xDefault && <link rel="alternate" hreflang="x-default" href={xDefault} />}

{/* Open Graph */}
<meta property="og:type" content={type} />
<meta property="og:site_name" content={AUTHOR_NAME} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:image" content={imageURL} />
{isDefaultImage && (
  <>
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
  </>
)}
{socialImageAlt && <meta property="og:image:alt" content={socialImageAlt} />}
<meta property="og:locale" content={ogLocale} />
{languageVersions.filter((v) => v.lang !== lang).map((v) => <meta property="og:locale:alternate" content={OG_LOCALES[v.lang]} />)}
{type === 'article' && publishedTime && (
  <meta property="article:published_time" content={publishedTime} />
)}
{type === 'article' && modifiedTime && (
  <meta property="article:modified_time" content={modifiedTime} />
)}
{type === 'article' && <meta property="article:author" content={AUTHOR_NAME} />}

{/* Twitter */}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageURL} />
{socialImageAlt && <meta name="twitter:image:alt" content={socialImageAlt} />}
<meta name="twitter:creator" content="@glunisok" />

{/* Feed autodiscovery */}
<link rel="alternate" type="application/rss+xml" title={t('site.feedTitle')} href={new URL(localePath(lang, '/rss.xml'), site)} />

{/* Structured data */}
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
