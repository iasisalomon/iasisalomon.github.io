---
// Centralized SEO head: canonical URL, robots, Open Graph, Twitter cards,
// and JSON-LD structured data. Rendered once inside <head> by MainLayout.
import { SITE_TITLE, LINKS } from '../consts';

interface Props {
  title: string;
  description: string;
  /** Page-relative or absolute image used for social previews. */
  image?: string;
  /** 'website' for normal pages, 'article' for blog posts / case studies. */
  type?: 'website' | 'article';
  /** ISO date — only used when type === 'article'. */
  publishedTime?: string;
  /** ISO date — only used when type === 'article'. */
  modifiedTime?: string;
  /** Set true to keep a page out of the index (e.g. thin/utility pages). */
  noindex?: boolean;
}

// 1200x630 card used when a page has no image of its own.
const DEFAULT_IMAGE = '/images/og-default.jpg';

const {
  title,
  description,
  image = DEFAULT_IMAGE,
  type = 'website',
  publishedTime,
  modifiedTime,
  noindex = false,
} = Astro.props;

const site = Astro.site ?? new URL('https://iasisalomon.pages.dev');
const canonicalURL = new URL(Astro.url.pathname, site);
const imageURL = new URL(image, site);
const isHomepage = Astro.url.pathname === '/';

// Social profiles that establish the "Iasi Salomon" entity across the web.
const sameAs = [
  LINKS.github,
  LINKS.linkedin,
  LINKS.x,
  LINKS.instagram,
  LINKS.tiktok,
  LINKS.telegram,
];

const person = {
  '@type': 'Person',
  '@id': `${site.origin}/#person`,
  name: 'Iasi Salomon',
  url: site.origin,
  image: new URL('/images/cara.jpg', site).href,
  jobTitle: 'Technical Delivery Manager',
  description:
    'Technical Delivery Manager with 5+ years leading remote, cross-functional tech teams. Delivery operations, automation and AI.',
  knowsAbout: [
    'Technical Delivery Management',
    'Delivery Operations',
    'Automation',
    'AI',
    'Agile and Scrum',
    'Software Engineering',
  ],
  sameAs,
};

const website = {
  '@type': 'WebSite',
  '@id': `${site.origin}/#website`,
  url: site.origin,
  name: SITE_TITLE,
  description,
  publisher: { '@id': `${site.origin}/#person` },
  inLanguage: 'en',
};

// Build the @graph: Person + WebSite are sitewide; BlogPosting only on articles.
const graph: Record<string, unknown>[] = [person, website];

if (type === 'article') {
  graph.push({
    '@type': 'BlogPosting',
    '@id': `${canonicalURL.href}#article`,
    headline: title,
    description,
    image: imageURL.href,
    url: canonicalURL.href,
    ...(publishedTime && { datePublished: publishedTime }),
    ...(modifiedTime && { dateModified: modifiedTime }),
    author: { '@id': `${site.origin}/#person` },
    publisher: { '@id': `${site.origin}/#person` },
    mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalURL.href },
    inLanguage: 'en',
  });
}

const jsonLd = { '@context': 'https://schema.org', '@graph': graph };
---

<!-- Google Search Console (backup verification method) -->
<meta name="google-site-verification" content="ulpwBKmYUACv90pdQhRC_Ha5ykZH13GYTWWvv7q1v6U" />

<!-- Canonical & robots -->
<link rel="canonical" href={canonicalURL} />
<meta
  name="robots"
  content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large, max-snippet:-1'}
/>
<meta name="author" content="Iasi Salomon" />

<!-- Open Graph -->
<meta property="og:type" content={type} />
<meta property="og:site_name" content="Iasi Salomon" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:image" content={imageURL} />
{image === DEFAULT_IMAGE && (
  <>
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Iasi Salomon, Technical Delivery Manager" />
  </>
)}
<meta property="og:locale" content="en_US" />
{type === 'article' && publishedTime && (
  <meta property="article:published_time" content={publishedTime} />
)}
{type === 'article' && modifiedTime && (
  <meta property="article:modified_time" content={modifiedTime} />
)}
{type === 'article' && <meta property="article:author" content="Iasi Salomon" />}

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageURL} />
<meta name="twitter:creator" content="@glunisok" />

<!-- Structured data -->
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
