---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';
import { readingTime } from '../../utils/content';

export async function getStaticPaths() {
	// Newest first; each post links to its newer and older neighbours.
	const posts = (await getCollection('blog')).sort(
		(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
	);
	return posts.map((post, i) => ({
		params: { slug: post.id },
		props: { post, newer: posts[i - 1], older: posts[i + 1] },
	}));
}

interface Props {
	post: CollectionEntry<'blog'>;
	newer?: CollectionEntry<'blog'>;
	older?: CollectionEntry<'blog'>;
}

const { post, newer, older } = Astro.props;
const { Content } = await render(post);
const link = (p?: CollectionEntry<'blog'>) => p && { title: p.data.title, href: `/blog/${p.id}/` };
---

<BlogPost
	title={post.data.title}
	description={post.data.description}
	pubDate={post.data.pubDate}
	updatedDate={post.data.updatedDate}
	heroImage={post.data.heroImage}
	heroImageAlt={post.data.heroImageAlt}
	category={post.data.category}
	lang={post.data.lang}
	award={post.data.award}
	readingTime={readingTime(post.body)}
	newer={link(newer)}
	older={link(older)}
>
	<Content />
</BlogPost>
