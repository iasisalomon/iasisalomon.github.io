---
import MainLayout from '../layouts/MainLayout.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import Experience from '../components/Experience.astro';
import Muba from '../components/Muba.astro';
import Skills from '../components/Skills.astro';
import Engineering from '../components/Engineering.astro';
import Community from '../components/Community.astro';
import Writing from '../components/Writing.astro';
import Testimonials from '../components/Testimonials.astro';
import Contact from '../components/Contact.astro';
import CustomFooter from '../components/CustomFooter.astro';
---

<MainLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<Navbar />
	<!-- Delivery profile first (matches CV and LinkedIn), everything else below. -->
	<Hero />
	<About />
	<Experience />
	<Muba />
	<Engineering />
	<Community />
	<Writing />
	<Skills />
	<Testimonials />
	<Contact />
	<CustomFooter />
</MainLayout>
